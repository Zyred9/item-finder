# 寻物记后端环境配置示例

# 数据库（MySQL，与 config/settings.py 默认一致）
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/item_finder?charset=utf8mb4

# 文件上传
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# 微信小程序
WECHAT_APPID=your_appid
WECHAT_SECRET=your_secret

# 百度语音 API
BAIDU_APP_ID=your_app_id
BAIDU_API_KEY=your_api_key
BAIDU_SECRET_KEY=your_secret_key

# 对话总结 + 找物意图解析：二选一，Key 均通过「环境变量名」配置（与 DEEPSEEK_ENV_KEY_NAME 一致）
# （1）百炼 Coding Plan：对话总结、找物意图解析，CODING_PLAN_ENV_KEY_NAME 填存 Key 的环境变量名
# 文档 https://help.aliyun.com/zh/model-studio/coding-plan-quickstart
CODING_PLAN_ENV_KEY_NAME=XUN_WU_JI_CODING_PLAN_KEY
CODING_PLAN_BASE_URL=https://coding.dashscope.aliyuncs.com/v1
CODING_PLAN_MODEL=qwen3.5-plus
# 例如：XUN_WU_JI_CODING_PLAN_KEY=sk-sp-xxxxx

# （2）DeepSeek：不配 Coding Plan 时使用
DEEPSEEK_ENV_KEY_NAME=XUN_WU_JI_DEEPSEEK_KEY
# 例如：XUN_WU_JI_DEEPSEEK_KEY=your_deepseek_api_key

# 百炼 · TTS + Qwen-VL + OCR + Fun-ASR（在百炼控制台创建 API Key）
BAILIAN_API_KEY=

# 百炼 Fun-ASR 语音识别需公网可访问的音频 URL，填本服务公网地址（本地可用 ngrok）
BACKEND_PUBLIC_URL=

# 调试模式
DEBUG=true
