# 寻物记 · 正式环境（部署时使用，勿提交敏感值到仓库）

# 数据库（生产 MySQL，请替换为实际连接串）
DATABASE_URL=mysql+pymysql://user:password@prod-db-host:3306/item_finder?charset=utf8mb4

# 文件上传（建议使用绝对路径或对象存储）
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=5242880

# 微信小程序（正式 AppID / Secret）
WECHAT_APPID=your_production_appid
WECHAT_SECRET=your_production_secret

# DeepSeek
DEEPSEEK_ENV_KEY_NAME=XUN_WU_JI_DEEPSEEK_KEY

# 百炼（TTS + VL + OCR + Fun-ASR）
BAILIAN_API_KEY=

# 正式环境关闭调试
DEBUG=false
