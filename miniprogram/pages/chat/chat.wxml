<!-- 对话找物页面 - UI-UX-PRO-MAX 重新设计 -->
<view class="chat-container">
  <!-- 顶部栏：渐变背景 + 主题色 -->
  <view class="chat-header">
    <view class="chat-header-inner">
      <view class="chat-header-title">
        <text class="title-icon">🔍</text>
        <text class="title-text">对话找物</text>
      </view>
      <view class="chat-header-actions">
        <view class="header-action-btn" bindtap="onSummarize">
          <text class="action-btn-icon">📋</text>
          <text class="action-btn-text">总结</text>
        </view>
        <view class="header-action-btn header-action-clear" bindtap="onClear">
          <text class="action-btn-icon">🗑️</text>
          <text class="action-btn-text">清空</text>
        </view>
      </view>
    </view>
  </view>

  <scroll-view class="chat-messages" scroll-y scroll-into-view="{{scrollToView}}" scroll-with-animation>
    <view class="messages-inner">
      <!-- 消息循环 -->
      <view wx:for="{{messages}}" wx:key="id" wx:for-item="item" wx:for-index="index">
        <!-- 用户消息 -->
        <view class="chat-message user-message" wx:if="{{item.role === 'user'}}" id="msg-{{index}}">
          <view class="user-message-content">
            <text class="user-message-text">{{item.content}}</text>
          </view>
        </view>
        
        <!-- AI 助手消息 -->
        <view class="chat-message assistant-message" wx:elif="{{item.role === 'assistant'}}" id="msg-{{index}}">
          <view class="assistant-avatar">
            <image class="assistant-avatar-img" src="../../assets/icons/bot.svg" mode="aspectFit" />
          </view>
          <view class="assistant-message-content">
            <!-- 有匹配结果：展示物品卡片 -->
            <view class="result-bubble" wx:if="{{item.matchedItems && item.matchedItems.length > 0}}">
              <view class="result-items-container">
                <view
                  class="result-item-card"
                  wx:for="{{item.matchedItems}}"
                  wx:for-item="mi"
                  wx:key="id"
                  wx:for-index="miIndex"
                  bindtap="onItemClick"
                  data-id="{{mi.id}}"
                >
                  <view class="result-item-image-wrap">
                    <image wx:if="{{mi.photo_path}}" class="result-item-image" src="{{mi.photo_path}}" mode="aspectFill" />
                    <view wx:else class="result-item-image result-item-placeholder">
                      <image class="result-placeholder-icon" src="{{mi.category_icon || '../../assets/icons/home.svg'}}" mode="aspectFit" />
                    </view>
                  </view>
                  <view class="result-item-body">
                    <view class="result-item-header">
                      <text class="result-item-name">{{mi.name}}</text>
                      <view wx:if="{{mi.expiry_status === 'expired'}}" class="expiry-badge expired">
                        <text class="badge-icon">⚠️</text>
                        <text class="badge-text">{{mi.expiry_label}}</text>
                      </view>
                      <view wx:elif="{{mi.expiry_status === 'expiring'}}" class="expiry-badge expiring">
                        <text class="badge-icon">⏰</text>
                        <text class="badge-text">{{mi.expiry_label}}</text>
                      </view>
                    </view>
                    <view class="result-item-location">
                      <text class="location-icon">📍</text>
                      <text class="location-text">{{mi.location}}</text>
                    </view>
                    <view class="result-item-footer" wx:if="{{mi.creator_name || mi.created_at}}">
                      <text class="footer-text">{{mi.creator_name || '我'}}</text>
                      <text class="footer-dot">·</text>
                      <text class="footer-time">{{mi.created_at}}</text>
                    </view>
                  </view>
                  <!-- 分隔线（除了最后一个） -->
                  <view class="result-item-divider" wx:if="{{miIndex < item.matchedItems.length - 1}}"></view>
                </view>
              </view>
            </view>
            
            <!-- 没有匹配结果：展示文字气泡和建议 -->
            <view class="text-bubble" wx:if="{{!item.matchedItems || item.matchedItems.length === 0}}">
              <text class="bubble-content">{{item.content}}</text>
              
              <view class="suggestion-container" wx:if="{{item.suggestions && item.suggestions.length > 0}}">
                <view
                  class="suggestion-tag"
                  wx:for="{{item.suggestions}}"
                  wx:for-item="sug"
                  wx:key="*this"
                  bindtap="onSuggestionTap"
                  data-text="{{sug}}"
                >
                  {{sug}}
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- AI 输入中状态 -->
      <view class="chat-message assistant-message" wx:if="{{isTyping}}" id="typing-anchor">
        <view class="assistant-avatar">
          <image class="assistant-avatar-img" src="../../assets/icons/bot.svg" mode="aspectFit" />
        </view>
        <view class="assistant-message-content">
          <view class="typing-bubble">
            <view class="typing-indicator">
              <view class="typing-dot typing-dot-1"></view>
              <view class="typing-dot typing-dot-2"></view>
              <view class="typing-dot typing-dot-3"></view>
            </view>
          </view>
        </view>
      </view>

      <view class="messages-bottom-space"></view>
    </view>
  </scroll-view>

  <!-- 语音识别结果展示 -->
  <view class="voice-result-bar" wx:if="{{showVoiceResult && voiceResultText}}">
    <view class="voice-result-content">
      <text class="voice-result-label">🎤 识别结果</text>
      <text class="voice-result-text">{{voiceResultText}}</text>
    </view>
  </view>

  <!-- 底部输入区 -->
  <view class="input-area">
    <!-- 文字输入模式 -->
    <block wx:if="{{inputMode === 'text'}}">
      <view class="input-wrapper">
        <view class="voice-trigger" bindtap="switchToVoiceMode">
          <image class="voice-trigger-icon" src="../../assets/icons/mic.svg" mode="aspectFit" />
        </view>
        <view class="input-box">
          <input
            class="text-input"
            placeholder="描述你要找的东西，如'剪刀在哪'..."
            placeholder-class="input-placeholder"
            value="{{inputText}}"
            bindinput="onInput"
            bindconfirm="sendMessage"
            confirm-type="send"
          />
        </view>
        <view class="send-trigger" bindtap="sendMessage">
          <text class="send-icon">🚀</text>
        </view>
      </view>
    </block>

    <!-- 语音输入模式 -->
    <block wx:else>
      <view class="voice-input-wrapper">
        <view class="voice-input-row">
          <view class="keyboard-trigger" bindtap="switchToTextMode">
            <text class="keyboard-icon">⌨️</text>
          </view>
          <view
            class="hold-to-talk {{isRecording ? 'recording' : ''}}"
            bindtouchstart="onStartRecord"
            bindtouchend="onStopRecord"
            bindtouchcancel="onCancelRecord"
          >
            <text class="hold-text">{{isRecording ? '松开发送' : '按住 说话'}}</text>
          </view>
        </view>
        <view class="voice-hint">💡 长按录音，松开发送 · 可说"钥匙在哪"</view>
      </view>
    </block>
  </view>
</view>