/* ===== 对话找物页面 - UI-UX-PRO-MAX 重新设计 ===== */
/* 主题色：橙红色系 #ff6b5b */

/* ===== 页面布局 ===== */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #fff9f8 0%, #fafafa 100%);
  overflow: hidden;
  box-sizing: border-box;
}

/* ===== 顶部导航栏 ===== */
.chat-header {
  flex-shrink: 0;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 0;
  box-shadow: 0 4rpx 24rpx rgba(255, 107, 91, 0.15);
}

.chat-header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
}

.chat-header-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.title-icon {
  font-size: 40rpx;
  line-height: 1;
}

.title-text {
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  letter-spacing: -0.3rpx;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-action-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.header-action-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

.header-action-clear {
  background: rgba(255, 255, 255, 0.15);
}

.action-btn-icon {
  font-size: 28rpx;
  line-height: 1;
}

.action-btn-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #fff;
}

/* ===== 消息区域 ===== */
.chat-messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.messages-inner {
  padding: 0;
}

/* 用户消息 */
.chat-message.user-message {
  display: flex;
  justify-content: flex-end;
  margin-bottom: 28rpx;
}

.user-message-content {
  max-width: 75%;
  padding: 24rpx 32rpx;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 91, 0.25);
}

.user-message-text {
  font-size: 28rpx;
  color: #fff;
  line-height: 1.6;
  word-break: break-word;
}

/* AI 助手消息 */
.chat-message.assistant-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.assistant-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e3 100%);
  border: 2rpx solid rgba(255, 107, 91, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  box-shadow: 0 3rpx 12rpx rgba(255, 107, 91, 0.08);
}

.assistant-avatar-img {
  width: 42rpx;
  height: 42rpx;
}

.assistant-message-content {
  flex: 1;
  min-width: 0;
  max-width: 85%;
}

/* ===== 文字气泡 ===== */
.text-bubble {
  background: #fff;
  padding: 18rpx 22rpx;
  border-radius: 24rpx 24rpx 24rpx 6rpx;
  box-shadow: 0 3rpx 12rpx rgba(0, 0, 0, 0.05);
}

.bubble-content {
  display: block;
  font-size: 26rpx;
  line-height: 1.7;
  color: #1a1a2e;
  word-break: break-word;
  white-space: pre-wrap;
}

/* 建议标签 */
.suggestion-container {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  gap: 12rpx;
}

.suggestion-tag {
  padding: 8rpx 20rpx;
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e3 100%);
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: #ff6b5b;
  border: 1rpx solid rgba(255, 107, 91, 0.15);
  transition: all 0.2s ease;
}

.suggestion-tag:active {
  background: linear-gradient(135deg, #ffe8e3 0%, #ffd5cf 100%);
  transform: scale(0.95);
}

/* ===== 结果卡片气泡 ===== */
.result-bubble {
  background: rgba(255, 255, 255, 0.7);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 24rpx 24rpx 24rpx 6rpx;
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  overflow: hidden;
  display: inline-block;
  max-width: 100%;
}

.result-items-container {
  display: flex;
  flex-direction: column;
}

/* 单个结果卡片 */
.result-item-card {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 20rpx;
  position: relative;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
}

.result-item-card:active {
  background: rgba(255, 245, 244, 0.5);
}

/* 图片区域 */
.result-item-image-wrap {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
  margin-right: 18rpx;
}

.result-item-image {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.3s ease;
}

.result-item-card:active .result-item-image {
  transform: scale(1.05);
}

.result-item-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(248,249,250,0.8) 0%, rgba(233,236,239,0.6) 100%);
}

.result-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
}

/* 卡片内容区 */
.result-item-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.result-item-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.result-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  word-break: break-word;
  flex: 1;
  line-height: 1.4;
}

/* 过期徽章 */
.expiry-badge {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.badge-icon {
  font-size: 24rpx;
  line-height: 1;
}

.badge-text {
  font-size: 19rpx;
  white-space: nowrap;
}

.expiry-badge.expired {
  background: linear-gradient(135deg, rgba(255,71,87,0.15) 0%, rgba(255,107,129,0.1) 100%);
  color: #ff4757;
  border: 1rpx solid rgba(255,71,87,0.2);
}

.expiry-badge.expiring {
  background: linear-gradient(135deg, rgba(255,165,2,0.12) 0%, rgba(255,140,66,0.1) 100%);
  color: #ff8c42;
  border: 1rpx solid rgba(255,165,2,0.18);
}

/* 位置信息 */
.result-item-location {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 8rpx;
  line-height: 1.5;
}

.location-icon {
  font-size: 28rpx;
  line-height: 1;
}

.location-text {
  word-break: break-word;
}

/* 底部信息 */
.result-item-footer {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 20rpx;
  color: #999999;
  line-height: 1.4;
}

.footer-text {
  color: inherit;
}

.footer-dot {
  color: #d0d0d0;
  font-weight: 300;
}

.footer-time {
  color: inherit;
}

/* 分隔线 */
.result-item-divider {
  position: absolute;
  bottom: 0;
  left: 144rpx;
  right: 24rpx;
  height: 1rpx;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(200, 200, 200, 0.12) 10%, 
    rgba(200, 200, 200, 0.12) 90%, 
    transparent 100%);
  z-index: 1;
  pointer-events: none;
}

/* ===== 搜索结果卡片 - UI-UX-PRO-MAX 重新设计 ===== */

/* 结果卡片列表容器 */
.result-card-list {
  display: flex;
  flex-direction: column;
  gap: 0rpx; /* 去掉间距，使用分隔线 */
}

/* 单个结果卡片 */
.result-card-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 20rpx;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
}

/* 第一个和最后一个圆角优化 */
.result-card-item:first-child {
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.result-card-item:last-child {
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}

/* 只有一个物品时恢复完整圆角 */
.result-card-item:only-child {
  border-radius: 20rpx;
}

/* 分隔线 */
.result-card-divider {
  position: absolute;
  bottom: 0;
  left: 128rpx; /* 从图片右侧开始 */
  right: 20rpx;
  height: 1rpx;
  background: linear-gradient(90deg, 
    transparent 0%, 
    rgba(200, 200, 200, 0.15) 10%, 
    rgba(200, 200, 200, 0.15) 90%, 
    transparent 100%);
  z-index: 1;
  pointer-events: none;
}

.result-card-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.8) 0%, rgba(255,255,255,0.4) 100%);
  z-index: 0;
  opacity: 0;
  transition: opacity 0.25s ease;
}

.result-card-item:active {
  transform: scale(0.98);
  background: rgba(255, 255, 255, 0.8);
}

.result-card-item:active::before {
  opacity: 1;
}

/* 图片区域 */
.result-card-image-wrap {
  position: relative;
  z-index: 1;
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 18rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.result-card-image {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.3s ease;
}

.result-card-item:active .result-card-image {
  transform: scale(1.05);
}

.result-card-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, rgba(248,249,250,0.8) 0%, rgba(233,236,239,0.6) 100%);
}

.result-card-placeholder-icon {
  width: 48rpx;
  height: 48rpx;
  opacity: 0.5;
  transition: opacity 0.2s ease;
}

.result-card-item:active .result-card-placeholder-icon {
  opacity: 0.7;
}

/* 内容区域 */
.result-card-content {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.result-card-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.result-card-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  word-break: break-word;
  flex: 1;
  line-height: 1.4;
}

/* 过期徽章 - 柔和渐变 */
.expiry-badge-card {
  flex-shrink: 0;
  padding: 3rpx 10rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: 600;
  white-space: nowrap;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.08);
}

.expiry-badge-card.expired {
  background: linear-gradient(135deg, rgba(255,71,87,0.15) 0%, rgba(255,107,129,0.1) 100%);
  color: #ff4757;
  border: 1rpx solid rgba(255,71,87,0.2);
}

.expiry-badge-card.expiring {
  background: linear-gradient(135deg, rgba(255,165,2,0.12) 0%, rgba(255,127,80,0.08) 100%);
  color: #ff8c42;
  border: 1rpx solid rgba(255,165,2,0.18);
}

/* 位置信息 */
.result-card-location {
  font-size: 25rpx;
  color: #666666;
  margin-bottom: 6rpx;
  word-break: break-word;
  line-height: 1.5;
  display: flex;
  align-items: center;
  gap: 4rpx;
}

/* 元信息 */
.result-card-meta {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 21rpx;
  color: #999999;
  line-height: 1.4;
}

.result-card-meta-text {
  color: inherit;
}

.result-card-dot {
  color: #d0d0d0;
  font-weight: 300;
}

/* 结果气泡框 - 柔和背景 */
.chat-bubble-result {
  background: linear-gradient(135deg, rgba(255,255,255,0.7) 0%, rgba(250,250,251,0.5) 100%);
  backdrop-filter: blur(20rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.6);
  box-shadow: 
    0 4rpx 16rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  padding: 20rpx;
  border-radius: 24rpx;
  border-bottom-left-radius: 16rpx;
}

/* ===== 输入中状态 ===== */
.typing-bubble {
  background: rgba(255, 255, 255, 0.95);
  padding: 16rpx 20rpx;
  border-radius: 24rpx 24rpx 24rpx 6rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  display: inline-block;
  width: auto;
  min-width: 0;
}

.typing-indicator {
  display: flex;
  align-items: center;
  gap: 6rpx;
  width: auto;
}

.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  animation: typing-bounce 1.2s infinite ease-in-out;
  flex-shrink: 0;
}

.typing-dot-1 { animation-delay: -0.3s; }
.typing-dot-2 { animation-delay: -0.15s; }
.typing-dot-3 { animation-delay: 0s; }

@keyframes typing-bounce {
  0%, 80%, 100% {
    transform: scale(0.5);
    opacity: 0.4;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.messages-bottom-space {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 语音识别结果 ===== */
.voice-result-bar {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e3 100%);
  border-top: 1rpx solid rgba(255, 107, 91, 0.1);
  border-bottom: 1rpx solid rgba(255, 107, 91, 0.1);
  box-sizing: border-box;
}

.voice-result-content {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.voice-result-label {
  font-size: 22rpx;
  color: #ff6b5b;
  font-weight: 500;
}

.voice-result-text {
  font-size: 26rpx;
  color: #1a1a2e;
  line-height: 1.5;
  word-break: break-word;
}

/* ===== 底部输入区 ===== */
.input-area {
  flex-shrink: 0;
  padding: 20rpx 28rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(240, 240, 240, 0.8);
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.04);
}

/* 文字输入模式 */
.input-wrapper {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.voice-trigger {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.voice-trigger:active {
  transform: scale(0.95);
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
}

.voice-trigger-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.7;
}

.input-box {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f1f3 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  padding: 0 32rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
}

.text-input {
  flex: 1;
  width: 100%;
  height: 100%;
  font-size: 28rpx;
  color: #1a1a2e;
  background: transparent;
}

.input-placeholder {
  color: #999999;
}

.send-trigger {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 91, 0.3);
  transition: all 0.2s ease;
}

.send-trigger:active {
  transform: scale(0.92);
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 91, 0.25);
}

.send-icon {
  font-size: 40rpx;
  line-height: 1;
}

/* 语音输入模式 */
.voice-input-wrapper {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.voice-input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.keyboard-trigger {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
  transition: all 0.2s ease;
}

.keyboard-trigger:active {
  transform: scale(0.95);
}

.keyboard-icon {
  font-size: 36rpx;
  line-height: 1;
}

.hold-to-talk {
  flex: 1;
  height: 88rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f1f3 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  transition: all 0.2s ease;
}

.hold-to-talk:active {
  background: linear-gradient(135deg, #e9ecef 0%, #dee2e6 100%);
}

.hold-to-talk.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border-color: transparent;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 91, 0.3);
}

.hold-text {
  font-size: 28rpx;
  font-weight: 500;
  color: #666666;
}

.hold-to-talk.recording .hold-text {
  color: #fff;
}

.voice-hint {
  font-size: 20rpx;
  color: #999999;
  text-align: center;
  line-height: 1.4;
}
