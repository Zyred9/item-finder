/* 对话找物页面样式 - 参考设计原型 v3 */

/* 整体固定高度：仅中间消息区滚动，底部输入区固定 */
.chat-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  min-height: 100vh;
  max-height: 100vh;
  background: linear-gradient(180deg, #fff6f3 0%, #fafafa 180rpx, #fafafa 100%);
  overflow: hidden;
  box-sizing: border-box;
}

.chat-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx 0 32rpx;
  background: rgba(255, 255, 255, 0.95);
  border-bottom: 1rpx solid #eee;
  box-sizing: border-box;
}

.chat-header-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.chat-header-actions {
  display: flex;
  align-items: center;
  margin-left: 16rpx;
}

.chat-header-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
  background: #f5f5f5;
  margin-left: 16rpx;
}

.chat-header-btn:active {
  background: #ebebeb;
}

.chat-header-btn-icon,
.chat-header-clear-icon {
  font-size: 32rpx;
  margin-right: 8rpx;
}

.chat-header-btn-text,
.chat-header-clear-text {
  font-size: 26rpx;
  color: #666;
}

.chat-header-clear {
  display: flex;
  align-items: center;
}

.chat-messages {
  flex: 1;
  min-height: 0;
  height: 0;
  padding: 0 28rpx;
  box-sizing: border-box;
}

.messages-inner {
  padding: 28rpx 0 0;
}

.chat-message {
  display: flex;
  align-items: flex-start;
  margin-bottom: 32rpx;
}

.chat-message.user {
  flex-direction: row-reverse;
}

.chat-body {
  max-width: 80%;
}

.chat-avatar {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.08);
}

.chat-avatar-img {
  width: 44rpx;
  height: 44rpx;
}

.chat-message.user .chat-avatar {
  margin-right: 0;
  margin-left: 20rpx;
}

.chat-message.assistant .chat-avatar {
  background: #fffaf7;
  border: 2rpx solid #ffb3a3;
}

.chat-message.user .chat-avatar {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
}

.chat-bubble {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 6rpx 20rpx rgba(0, 0, 0, 0.05);
}

.chat-message.assistant .chat-bubble {
  background: #ffffff;
  border-bottom-left-radius: 10rpx;
}

.chat-message.user .chat-bubble {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-bottom-right-radius: 10rpx;
}

.bubble-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.7;
  word-break: break-word;
  white-space: pre-wrap;
}

.chat-message.assistant .bubble-text {
  color: #1a1a2e;
}

.chat-message.user .bubble-text {
  color: #ffffff;
}

.chat-suggestions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 20rpx;
  margin-right: -14rpx;
  margin-bottom: -14rpx;
}

.suggestion-chip {
  margin-right: 14rpx;
  margin-bottom: 14rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #fff5f4 0%, #ffefe9 100%);
  color: #ff6b5b;
  font-size: 24rpx;
  font-weight: 500;
  border: 1rpx solid transparent;
}

.suggestion-chip:active {
  border-color: #ff6b5b;
  transform: scale(0.98);
}

.search-result {
  margin-top: 20rpx;
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  border: 1rpx solid #f3f3f3;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.04);
}

.search-result-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx 18rpx;
  background: linear-gradient(180deg, #fff8f6 0%, #ffffff 100%);
  border-bottom: 1rpx solid #f5f5f5;
}

.search-result-title {
  font-size: 24rpx;
  color: #666666;
  font-weight: 500;
}

.search-result-count {
  min-width: 72rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #fff0eb;
  color: #ff6b5b;
  font-size: 22rpx;
  text-align: center;
}

.search-result-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
}

.search-result-item:last-child {
  border-bottom: none;
}

.search-result-item:active {
  background: #fafafa;
}

.result-image {
  width: 88rpx;
  height: 88rpx;
  border-radius: 22rpx;
  overflow: hidden;
  flex-shrink: 0;
  margin-right: 20rpx;
}

.result-image-placeholder {
  background: linear-gradient(135deg, #f8f9fa 0%, #eceff3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.result-placeholder-icon {
  width: 44rpx;
  height: 44rpx;
  opacity: 0.55;
}

.result-info {
  flex: 1;
  min-width: 0;
}

.result-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 6rpx;
}

.result-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  word-break: break-word;
}

.result-location {
  font-size: 25rpx;
  color: #8f8f8f;
  margin-bottom: 6rpx;
  word-break: break-word;
}

.result-meta {
  font-size: 22rpx;
  color: #a0a0a0;
  word-break: break-word;
}

.typing-bubble {
  min-width: 120rpx;
  padding: 24rpx 28rpx;
}

.typing-dots {
  display: flex;
  align-items: center;
}

.typing-dots .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #ff6b5b;
  animation: typing 1.4s infinite ease-in-out both;
}

.typing-dots .dot + .dot {
  margin-left: 10rpx;
}

.typing-dots .dot:nth-child(1) {
  animation-delay: -0.32s;
}

.typing-dots .dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes typing {
  0%,
  80%,
  100% {
    transform: scale(0.6);
    opacity: 0.5;
  }

  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.messages-bottom-space {
  height: 160rpx;
}

/* 语音识别结果展示块（与整体布局统一，不参与滚动） */
.chat-voice-result-bar {
  flex-shrink: 0;
  padding: 20rpx 24rpx;
  background: #f8f8f8;
  border-top: 1rpx solid #ededed;
  border-left: 6rpx solid #ff6b5b;
  margin: 0 24rpx;
  margin-top: 12rpx;
  border-radius: 0 16rpx 16rpx 0;
  box-sizing: border-box;
}

.chat-voice-result-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.chat-voice-result-text {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.5;
  word-break: break-all;
}

/* 底部输入区：固定不滚动 */
.chat-input-area {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 24rpx 18rpx;
  padding-bottom: calc(18rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  border-top: 1rpx solid #ededed;
  box-shadow: 0 -10rpx 30rpx rgba(0, 0, 0, 0.04);
}

.chat-voice-btn,
.chat-send-btn {
  width: 84rpx;
  height: 84rpx;
  min-width: 84rpx;
  min-height: 84rpx;
  max-width: 84rpx;
  max-height: 84rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-sizing: border-box;
}

.chat-voice-btn {
  margin-right: 18rpx;
  background: #f0f0f0;
  color: #666666;
  font-size: 32rpx;
}

.chat-voice-btn-img {
  width: 32rpx;
  height: 32rpx;
}

.chat-voice-btn:active {
  background: #e6e6e6;
}

.chat-voice-btn.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  color: #ffffff;
}

.chat-send-btn {
  margin-left: 18rpx;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  color: #ffffff;
  box-shadow: 0 10rpx 24rpx rgba(255, 107, 91, 0.28);
}

.chat-send-btn text {
  font-size: 32rpx;
}

.chat-send-btn:active {
  transform: scale(0.96);
}

.chat-input-wrapper {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-radius: 42rpx;
  background: #f5f5f5;
  box-sizing: border-box;
}

.chat-input {
  flex: 1;
  width: 100%;
  height: 84rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: transparent;
  box-sizing: border-box;
}

.chat-input-placeholder {
  color: #b0b0b0;
}

/* 语音输入模式：键盘切回 + 按住说话 */
.chat-voice-mode-area {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.chat-voice-mode-wrap {
  display: flex;
  align-items: center;
}

.chat-voice-hint {
  font-size: 22rpx;
  color: #999;
  margin-top: 12rpx;
  padding-left: 2rpx;
  line-height: 1.4;
}

.chat-keyboard-btn {
  width: 84rpx;
  height: 84rpx;
  min-width: 84rpx;
  min-height: 84rpx;
  max-width: 84rpx;
  max-height: 84rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #f0f0f0;
  font-size: 34rpx;
  box-sizing: border-box;
}

.chat-keyboard-btn:active {
  background: #e6e6e6;
}

.chat-hold-to-talk {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  border-radius: 42rpx;
  background: #f5f5f5;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #666;
  box-sizing: border-box;
}

.chat-hold-to-talk:active {
  background: #ebebeb;
}

.chat-hold-to-talk.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  color: #fff;
}
