<!-- 物品详情页 - 与整体风格统一，底部操作栏固定 -->
<view class="detail-page" wx:if="{{!loading && item}}">
  <!-- 可滚动内容区 -->
  <scroll-view class="detail-scroll" scroll-y>
    <view class="detail-header">
      <view class="detail-photo-wrap" bindtap="onPreviewImage">
        <image wx:if="{{item.photo_path}}" class="detail-photo" src="{{item.photo_path}}" mode="aspectFill" />
        <view wx:else class="detail-photo-placeholder">
          <image class="detail-photo-icon-img" src="../../assets/icons/map-pin.svg" mode="aspectFit" />
          <text class="detail-photo-text">暂无照片</text>
        </view>
      </view>
      <view class="detail-title-wrap">
        <view class="detail-title">{{item.name}}</view>
        <view class="detail-location">📍 {{item.location}}</view>
      </view>
    </view>

    <view class="section">
      <view class="info-card">
        <view class="info-card-title">基本信息</view>
        <view class="info-row">
          <text class="info-label">物品名称</text>
          <text class="info-value">{{item.name}}</text>
        </view>
        <view class="info-row">
          <text class="info-label">存放位置</text>
          <text class="info-value info-value-highlight">{{item.location}}</text>
        </view>
        <view class="info-row" wx:if="{{item.description}}">
          <text class="info-label">描述</text>
          <text class="info-value info-value-desc">{{item.description}}</text>
        </view>
        <view class="info-row" wx:if="{{item.category_name}}">
          <text class="info-label">分类</text>
          <text class="info-value">{{item.category_name}}</text>
        </view>
        <view class="info-row info-row-last">
          <text class="info-label">存放人</text>
          <text class="info-value">{{item.creator_name || '我'}}</text>
        </view>
        <view class="info-row info-row-last">
          <text class="info-label">存放时间</text>
          <text class="info-value">{{createdAtText}}</text>
        </view>
      </view>
    </view>

    <view class="section" wx:if="{{hasExtensionFields && extensionRows.length > 0}}">
      <view class="info-card extension-card">
        <view class="info-card-title">扩展信息</view>
        <view class="info-row {{index === extensionRows.length - 1 ? 'info-row-last' : ''}}" wx:for="{{extensionRows}}" wx:for-item="row" wx:key="label">
          <text class="info-label">{{row.label}}</text>
          <text class="info-value">{{row.value}}</text>
        </view>
      </view>
    </view>
    <!-- 底部留白，避免最后一块内容被固定栏遮挡 -->
    <view class="detail-bottom-pad"></view>
  </scroll-view>

  <!-- 固定在底部的操作区 -->
  <view class="action-section-fixed">
    <button class="btn-primary" bindtap="onEdit">编辑</button>
    <button class="btn-danger" bindtap="onDelete">删除</button>
  </view>
</view>

<view class="loading-wrap" wx:if="{{loading}}">
  <view class="loading-text">加载中...</view>
</view>

<view class="empty-wrap" wx:elif="{{!loading && !item}}">
  <image class="empty-icon" src="../../assets/icons/map-pin.svg" mode="aspectFit" />
  <text class="empty-text">物品不存在或已删除</text>
</view>
