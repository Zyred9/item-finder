/* 物品详情页 - 现代化精致设计 */

/* ===== 变量定义 ===== */
page {
  --primary-gradient: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  --accent-gradient: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  --expired-gradient: linear-gradient(135deg, #ff4757 0%, #ff6b81 100%);
  --expiring-gradient: linear-gradient(135deg, #ffa502 0%, #ff7f50 100%);
  --card-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
  --card-shadow-hover: 0 12rpx 48rpx rgba(0, 0, 0, 0.1);
  --border-radius-large: 40rpx;
  --border-radius-medium: 28rpx;
  --border-radius-small: 20rpx;
}

/* ===== 页面布局 ===== */
.detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #f8f9fa 0%, #fafbfc 100%);
  box-sizing: border-box;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
  overflow: hidden;
}

.detail-bottom-safe {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* ===== 头部区域 - 沉浸式设计 ===== */
.detail-header {
  position: relative;
  background: transparent;
}

.detail-photo-wrap {
  width: 100%;
  height: 420rpx;
  position: relative;
  overflow: hidden;
}

.detail-photo {
  width: 100%;
  height: 100%;
  display: block;
  transition: transform 0.3s ease;
}

.detail-photo-wrap:active .detail-photo {
  transform: scale(1.02);
}

.detail-photo-placeholder {
  width: 100%;
  height: 100%;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.detail-photo-placeholder::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.detail-placeholder-icon {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.9;
  position: relative;
  z-index: 1;
}

.detail-placeholder-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  font-weight: 500;
  position: relative;
  z-index: 1;
}

/* 过期标签 - 悬浮徽章 */
.expiry-badge {
  position: absolute;
  top: 24rpx;
  right: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  z-index: 10;
  backdrop-filter: blur(10rpx);
}

.expiry-badge.expired {
  background: var(--expired-gradient);
}

.expiry-badge.expiring {
  background: var(--expiring-gradient);
}

.expiry-badge-icon {
  font-size: 28rpx;
  line-height: 1;
}

.expiry-badge-text {
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
}

/* 毛玻璃信息区 */
.detail-header-info {
  position: relative;
  background: rgba(255, 255, 255, 0.98);
  margin: -40rpx 32rpx 0;
  padding: 40rpx 32rpx 32rpx;
  border-radius: var(--border-radius-large) var(--border-radius-large) var(--border-radius-medium) var(--border-radius-medium);
  box-shadow: var(--card-shadow);
  z-index: 5;
}

.detail-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1a1a2e;
  line-height: 1.3;
  margin-bottom: 16rpx;
  letter-spacing: -0.5rpx;
}

.detail-location-wrap {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 20rpx;
  background: linear-gradient(135deg, #f8f9fa 0%, #f0f1f3 100%);
  border-radius: var(--border-radius-small);
  margin-top: 8rpx;
}

.location-icon {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.detail-location {
  font-size: 28rpx;
  color: #666;
  font-weight: 500;
  line-height: 1.4;
}

/* ===== 内容区域 ===== */
.detail-content {
  padding: 40rpx 32rpx 0;
}

/* 快速信息卡 */
.quick-info-card {
  background: #fff;
  border-radius: var(--border-radius-large);
  padding: 28rpx;
  box-shadow: var(--card-shadow);
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.quick-info-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0 16rpx;
}

.quick-info-icon {
  font-size: 40rpx;
  margin-bottom: 12rpx;
}

.quick-info-content {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.quick-info-label {
  font-size: 22rpx;
  color: #999;
  font-weight: 400;
}

.quick-info-value {
  font-size: 26rpx;
  color: #1a1a2e;
  font-weight: 600;
  max-width: 180rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.quick-info-divider {
  width: 1rpx;
  height: 60rpx;
  background: linear-gradient(180deg, transparent 0%, #e0e0e0 50%, transparent 100%);
  margin: 0 8rpx;
}

/* 信息区块 */
.info-section {
  margin-bottom: 40rpx;
}

.section-header {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
  padding-left: 8rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1a1a2e;
  letter-spacing: -0.5rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #999;
  font-weight: 400;
}

.info-card {
  background: #fff;
  border-radius: var(--border-radius-large);
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  overflow: hidden;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  gap: 24rpx;
}

.info-row:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.info-row:first-child {
  padding-top: 0;
}

.info-label-wrap {
  flex-shrink: 0;
  width: 160rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999;
  font-weight: 500;
  line-height: 1.5;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a2e;
  font-weight: 500;
  line-height: 1.6;
  word-break: break-word;
}

.info-value-location {
  display: flex;
  align-items: center;
  gap: 10rpx;
  color: #ff6b5b;
  font-weight: 600;
}

.location-dot {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.info-value-desc {
  white-space: pre-wrap;
  line-height: 1.8;
  color: #555;
}

/* 扩展信息网格 */
.extension-grid {
  background: #fff;
  border-radius: var(--border-radius-large);
  padding: 32rpx;
  box-shadow: var(--card-shadow);
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 28rpx;
}

.extension-item {
  background: linear-gradient(135deg, #f8f9fa 0%, #fafbfc 100%);
  border-radius: var(--border-radius-medium);
  padding: 28rpx 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.extension-item:active {
  transform: scale(0.98);
}

.extension-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
  letter-spacing: -0.3rpx;
}

.extension-value {
  font-size: 30rpx;
  color: #1a1a2e;
  font-weight: 600;
  line-height: 1.4;
  word-break: break-word;
}

/* ===== 底部操作栏 ===== */
.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 20rpx 32rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.98);
  backdrop-filter: blur(20rpx);
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -6rpx 24rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
  gap: 20rpx;
}

.action-btn {
  flex: 1;
  height: 88rpx;
  border-radius: var(--border-radius-medium);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  position: relative;
  overflow: hidden;
}

.action-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, transparent 50%);
  z-index: 1;
}

.action-btn:active {
  transform: scale(0.96);
}

.action-btn-icon {
  font-size: 30rpx;
  line-height: 1;
  position: relative;
  z-index: 2;
}

.action-btn-text {
  font-size: 28rpx;
  font-weight: 600;
  position: relative;
  z-index: 2;
}

.action-btn-edit {
  background: var(--primary-gradient);
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.35);
}

.action-btn-edit .action-btn-text {
  color: #fff;
}

.action-btn-delete {
  background: #fff;
  border: 2rpx solid #ffe0e0;
  box-shadow: 0 8rpx 24rpx rgba(255, 77, 79, 0.15);
}

.action-btn-delete .action-btn-text {
  color: #ff4d4f;
}

/* ===== 加载状态 ===== */
.loading-state {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8f9fa 0%, #fafbfc 100%);
  gap: 24rpx;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid #f0f0f0;
  border-top-color: #ff6b5b;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
}

/* ===== 空状态 ===== */
.empty-state {
  height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #f8f9fa 0%, #fafbfc 100%);
  padding: 80rpx 40rpx;
  text-align: center;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 40rpx;
  opacity: 0.4;
}

.empty-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 16rpx;
  letter-spacing: -0.5rpx;
}

.empty-subtitle {
  font-size: 28rpx;
  color: #999;
  font-weight: 400;
  line-height: 1.6;
}
