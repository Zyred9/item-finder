/* 物品详情页 - 与整体风格统一，底部操作栏固定 */

.detail-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #fafafa;
  box-sizing: border-box;
}

.detail-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.detail-bottom-pad {
  height: calc(180rpx + constant(safe-area-inset-bottom));
  height: calc(180rpx + env(safe-area-inset-bottom));
}

/* 头部：照片 + 标题 */
.detail-header {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 0 0 48rpx;
  position: relative;
  overflow: hidden;
}

.detail-header::before {
  content: '';
  position: absolute;
  top: -40%;
  right: -20%;
  width: 360rpx;
  height: 360rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.detail-photo-wrap {
  width: 100%;
  height: 380rpx;
  overflow: hidden;
  position: relative;
  z-index: 1;
}

.detail-photo {
  width: 100%;
  height: 100%;
  display: block;
}

.detail-photo-placeholder {
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.08);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.detail-photo-icon {
  font-size: 96rpx;
  margin-bottom: 16rpx;
  opacity: 0.9;
}

.detail-photo-text {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.85);
}

.detail-title-wrap {
  padding: 0 40rpx;
  position: relative;
  z-index: 1;
}

.detail-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  line-height: 1.3;
  word-break: break-word;
}

.detail-location {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.92);
}

/* 区块 */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
}

.info-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.info-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.info-row {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.info-row-last,
.info-row:last-child {
  border-bottom: none;
}

.info-label {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #999;
}

.info-value {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1a1a2e;
  word-break: break-word;
  line-height: 1.5;
}

.info-value-highlight {
  color: #ff6b5b;
  font-weight: 600;
}

.info-value-desc {
  white-space: pre-wrap;
}

.extension-card .info-row {
  padding: 20rpx 0;
}

/* 固定在底部的操作区 */
.action-section-fixed {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  padding: 24rpx 40rpx;
  padding-bottom: calc(24rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-sizing: border-box;
  z-index: 10;
}

.action-section-fixed .btn-primary,
.action-section-fixed .btn-danger {
  flex: 1;
  margin-right: 24rpx;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: none;
}

.action-section-fixed .btn-danger:last-child {
  margin-right: 0;
}

.action-section-fixed .btn-primary::after,
.action-section-fixed .btn-danger::after {
  border: none;
}

.action-section-fixed .btn-primary {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 91, 0.35);
}

.action-section-fixed .btn-danger {
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
}

/* 加载与空状态 */
.loading-wrap,
.empty-wrap {
  min-height: 60vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #fafafa;
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
  opacity: 0.5;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
