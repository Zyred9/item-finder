<!-- 物品编辑页面 - UI-UX-PRO-MAX 设计 -->
<view class="edit-container">
  <!-- 顶部导航栏 -->
  <view class="edit-header">
    <view class="header-left" bindtap="onCancel">
      <text class="cancel-btn">取消</text>
    </view>
    <view class="header-title">编辑物品</view>
    <view class="header-right" bindtap="onSave">
      <text class="save-btn">保存</text>
    </view>
  </view>

  <scroll-view class="edit-scroll" scroll-y>
    <view class="edit-content">
      
      <!-- 物品图片 -->
      <view class="photo-section">
        <view class="photo-wrapper" bindtap="onChoosePhoto">
          <image wx:if="{{formData.photo_path}}" class="photo-preview" src="{{formData.photo_path}}" mode="aspectFill" />
          <view wx:else class="photo-placeholder">
            <text class="photo-icon">📷</text>
            <text class="photo-text">点击更换图片</text>
          </view>
        </view>
      </view>

      <!-- 基本信息卡片 -->
      <view class="form-card">
        <view class="card-header">
          <text class="card-title">基本信息</text>
        </view>

        <!-- 物品名称 -->
        <view class="form-item">
          <view class="form-label-row">
            <text class="form-label">物品名称</text>
            <text class="form-required">*</text>
          </view>
          <input
            class="form-input"
            placeholder="请输入物品名称"
            placeholder-class="input-placeholder"
            value="{{formData.name}}"
            maxlength="13"
            bindinput="onNameInput"
          />
          <view class="char-counter {{nameLengthWarn ? 'warn' : ''}}">{{formData.name.length}}/13</view>
        </view>

        <!-- 存放位置 -->
        <view class="form-item">
          <view class="form-label-row">
            <text class="form-label">存放位置</text>
            <text class="form-required">*</text>
          </view>
          <input
            class="form-input"
            placeholder="请输入存放位置"
            placeholder-class="input-placeholder"
            value="{{formData.location}}"
            bindinput="onLocationInput"
          />
        </view>

        <!-- 物品描述 -->
        <view class="form-item">
          <view class="form-label-row">
            <text class="form-label">描述</text>
            <text class="form-optional">选填</text>
          </view>
          <textarea
            class="form-textarea"
            placeholder="补充说明物品特征、用途等"
            placeholder-class="input-placeholder"
            value="{{formData.description}}"
            maxlength="200"
            bindinput="onDescriptionInput"
          />
        </view>

        <!-- 分类选择 -->
        <view class="form-item">
          <view class="form-label-row">
            <text class="form-label">分类</text>
            <text class="form-optional">选填</text>
          </view>
          <view class="category-picker" bindtap="onChooseCategory">
            <text class="category-text">{{selectedCategory ? selectedCategory.name : '选择分类'}}</text>
            <text class="category-arrow">›</text>
          </view>
        </view>
      </view>

      <!-- 扩展信息卡片 -->
      <view class="form-card" wx:if="{{extensionFields.length > 0}}">
        <view class="card-header">
          <text class="card-title">扩展信息</text>
          <text class="card-subtitle">凭证与详情</text>
        </view>

        <view class="extension-grid">
          <view class="ext-item" wx:for="{{extensionFields}}" wx:for-item="field" wx:key="name">
            <text class="ext-label">{{field.label}}</text>
            
            <!-- 日期类型 -->
            <picker wx:if="{{field.type === 'date'}}" mode="date" value="{{extensionValues[field.name] || ''}}" bindchange="onDateChange" data-field="{{field.name}}">
              <view class="ext-picker">
                <text class="ext-value">{{extensionValues[field.name] || '选择日期'}}</text>
                <text class="ext-arrow">›</text>
              </view>
            </picker>
            
            <!-- 数字类型 -->
            <input wx:elif="{{field.type === 'number'}}" class="ext-input" type="number" placeholder="请输入" value="{{extensionValues[field.name] || ''}}" bindinput="onExtInput" data-field="{{field.name}}" />
            
            <!-- 文本类型 -->
            <input wx:else class="ext-input" type="text" placeholder="请输入" value="{{extensionValues[field.name] || ''}}" bindinput="onExtInput" data-field="{{field.name}}" />
          </view>
        </view>
      </view>

      <!-- 底部安全区 -->
      <view class="bottom-safe"></view>
    </view>
  </scroll-view>

  <!-- 底部保存按钮 -->
  <view class="bottom-action">
    <button class="save-button" bindtap="onSave" loading="{{submitting}}">
      <text wx:if="{{!submitting}}">保存修改</text>
      <text wx:else>保存中...</text>
    </button>
  </view>
</view>

<!-- 加载状态 -->
<view class="loading-overlay" wx:if="{{loading}}">
  <view class="loading-spinner"></view>
  <text class="loading-text">加载中...</text>
</view>
