/* ===== 物品编辑页面 - UI-UX-PRO-MAX 设计 ===== */
/* 主题色：橙红色系 #ff6b5b */

/* ===== 页面布局 ===== */
.edit-container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: linear-gradient(180deg, #f8f9fa 0%, #fafbfc 100%);
  overflow: hidden;
}

/* ===== 顶部导航栏 ===== */
.edit-header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 100rpx;
  padding: 0 32rpx;
  background: #fff;
  border-bottom: 1rpx solid #f0f0f0;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.04);
}

.header-left,
.header-right {
  width: 120rpx;
}

.header-title {
  flex: 1;
  text-align: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.cancel-btn,
.save-btn {
  font-size: 28rpx;
  font-weight: 500;
}

.cancel-btn {
  color: #999;
}

.save-btn {
  color: #ff6b5b;
}

/* ===== 滚动内容区 ===== */
.edit-scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.edit-content {
  padding: 32rpx 0;
}

/* ===== 图片区域 ===== */
.photo-section {
  padding: 0 32rpx 32rpx;
}

.photo-wrapper {
  width: 100%;
  height: 400rpx;
  border-radius: 32rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.06);
}

.photo-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.photo-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.photo-icon {
  font-size: 80rpx;
  opacity: 0.5;
}

.photo-text {
  font-size: 28rpx;
  color: #999;
}

/* ===== 表单卡片 ===== */
.form-card {
  margin: 0 32rpx 32rpx;
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.card-header {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 32rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
}

.card-subtitle {
  font-size: 24rpx;
  color: #999;
}

/* ===== 表单项 ===== */
.form-item {
  margin-bottom: 32rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.form-label-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.form-required {
  color: #ff4d4f;
  font-size: 28rpx;
}

.form-optional {
  color: #999;
  font-size: 24rpx;
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
  font-size: 30rpx;
  color: #1a1a2e;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #ccc;
}

.char-counter {
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 12rpx;
}

.char-counter.warn {
  color: #ff9800;
}

/* ===== 分类选择器 ===== */
.category-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #f8f9fa;
  border-radius: 20rpx;
}

.category-text {
  font-size: 30rpx;
  color: #1a1a2e;
}

.category-arrow {
  font-size: 40rpx;
  color: #ccc;
  line-height: 1;
}

/* ===== 扩展信息网格 ===== */
.extension-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

.ext-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ext-label {
  font-size: 24rpx;
  color: #999;
  font-weight: 500;
}

.ext-picker,
.ext-input {
  padding: 16rpx 20rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1a1a2e;
}

.ext-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ext-value {
  font-size: 28rpx;
  color: #1a1a2e;
}

.ext-arrow {
  font-size: 36rpx;
  color: #ccc;
  line-height: 1;
}

/* ===== 底部操作栏 ===== */
.bottom-action {
  flex-shrink: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background: #fff;
  border-top: 1rpx solid #f0f0f0;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.save-button {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 91, 0.3);
}

.save-button::after {
  border: none;
}

.save-button[loading] {
  opacity: 0.8;
}

/* ===== 底部安全区 ===== */
.bottom-safe {
  height: 32rpx;
}

/* ===== 加载遮罩 ===== */
.loading-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  z-index: 1000;
}

.loading-spinner {
  width: 80rpx;
  height: 80rpx;
  border: 6rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}
