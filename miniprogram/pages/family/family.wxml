<!--家庭管理页-->
<view class="container">
  <!-- 已有家庭 -->
  <view wx:if="{{familyInfo}}">
    <view class="family-card">
      <image class="family-icon" src="../../assets/icons/home.svg" mode="aspectFit" />
      <text class="family-name">{{familyInfo.name}}</text>
      <text class="member-count">{{members.length}} 位成员</text>
    </view>
    
    <view class="invite-section">
      <text class="section-title">邀请家人</text>
      <view class="invite-code">
        <text class="code">{{inviteCode}}</text>
        <text class="copy-btn" bindtap="onCopyCode">复制</text>
      </view>
      <text class="hint">分享邀请码给家人，让他们加入你的家庭</text>
    </view>
    
    <view class="members-section">
      <text class="section-title">家庭成员</text>
      <view class="member-item" wx:for="{{members}}" wx:key="id">
        <view class="member-avatar">
          <image class="member-avatar-img" src="../../assets/icons/user-round.svg" mode="aspectFit" />
        </view>
        <view class="member-content">
          <input
            wx:if="{{editingRemarkUserId === item.id}}"
            class="member-name-input"
            value="{{item._tempRemark || item.remark || item.nickname || ''}}"
            placeholder="填写备注（最多6个字）"
            maxlength="6"
            focus="true"
            bindinput="onRemarkInput"
            bindblur="onRemarkBlur"
            data-user-id="{{item.id}}"
          />
          <view wx:else class="member-name-display">
            <text class="member-name">
              {{item.remark || item.nickname || '未命名'}}
            </text>
            <text wx:if="{{item.is_admin}}" class="member-admin-inline">管理员</text>
          </view>
        </view>
        <text
          class="edit-icon"
          bindtap="onRemarkEditTap"
          data-user-id="{{item.id}}"
        >✎</text>
      </view>
    </view>
  </view>
  
  <!-- 无家庭 -->
  <view wx:else>
    <view class="empty-section">
      <image class="empty-icon" src="../../assets/icons/home.svg" mode="aspectFit" />
      <text class="empty-text">你还没有加入家庭</text>
    </view>
    
    <view class="action-section">
      <button class="btn-primary" bindtap="onCreateFamily">创建家庭</button>
      
      <view class="divider">
        <text>或者</text>
      </view>
      
      <view class="join-section">
        <input class="code-input" placeholder="输入6位邀请码" maxlength="6" value="{{inputCode}}" bindinput="onInputCode" />
        <button class="btn-secondary" bindtap="onJoinFamily">加入家庭</button>
      </view>
    </view>
  </view>
</view>