.container { padding: 20rpx; min-height: 100vh; background: #f5f5f5; }
.family-card { background: linear-gradient(135deg, #FF6B5B 0%, #ff8a7a 100%); border-radius: 16rpx; padding: 40rpx; color: #fff; display: flex; align-items: center; gap: 16rpx; }
.family-icon { width: 48rpx; height: 48rpx; }
.family-name { display: block; font-size: 36rpx; font-weight: bold; }
.member-count { font-size: 26rpx; opacity: 0.8; margin-top: 10rpx; }
.invite-section { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-top: 20rpx; }
.section-title { font-size: 30rpx; font-weight: bold; margin-bottom: 20rpx; }
.invite-code { display: flex; align-items: center; gap: 20rpx; }
.code { font-size: 48rpx; font-weight: bold; color: #FF6B5B; letter-spacing: 10rpx; }
.copy-btn { padding: 10rpx 20rpx; background: #FF6B5B; color: #fff; border-radius: 8rpx; font-size: 26rpx; }
.hint { display: block; font-size: 24rpx; color: #999; margin-top: 16rpx; }
.members-section { background: #fff; border-radius: 16rpx; padding: 30rpx; margin-top: 20rpx; }
.member-item { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.member-item:last-child { border-bottom: none; }
.member-avatar { width: 60rpx; height: 60rpx; background: #f0f0f0; border-radius: 50%; margin-right: 16rpx; display: flex; align-items: center; justify-content: center; }
.member-avatar-img { width: 40rpx; height: 40rpx; }
.member-name { flex: 1; font-size: 30rpx; }
.member-admin { font-size: 24rpx; color: #FF6B5B; }
.empty-section { text-align: center; padding: 100rpx 0; }
.empty-icon { width: 100rpx; height: 100rpx; }
.empty-text { display: block; font-size: 30rpx; color: #999; margin-top: 20rpx; }
.action-section { padding: 40rpx; }
.btn-primary,
.btn-secondary {
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: none;
}
.btn-primary::after,
.btn-secondary::after { border: none; }
.btn-primary { width: 100%; height: 90rpx; background: #FF6B5B; color: #fff; border-radius: 45rpx; font-size: 32rpx; }
.divider { text-align: center; margin: 40rpx 0; color: #999; }
.join-section { display: flex; gap: 16rpx; }
.code-input { flex: 1; height: 80rpx; background: #fff; border-radius: 16rpx; padding: 0 20rpx; font-size: 32rpx; text-align: center; letter-spacing: 10rpx; }
.btn-secondary { width: 200rpx; height: 80rpx; background: #00B894; color: #fff; border-radius: 16rpx; font-size: 28rpx; }
.copy-btn { display: inline-flex; align-items: center; justify-content: center; text-align: center; }