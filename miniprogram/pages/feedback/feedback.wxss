.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: 80rpx;
  box-sizing: border-box;
}

.feedback-header {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 48rpx 40rpx 56rpx;
  position: relative;
  overflow: hidden;
}

.feedback-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.feedback-header-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.feedback-header-desc {
  display: block;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.9);
  line-height: 1.5;
  position: relative;
  z-index: 1;
}

.form-card {
  margin: -24rpx 40rpx 0;
  padding: 40rpx 32rpx;
  background: #fff;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.06);
  position: relative;
  z-index: 2;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.form-label .required {
  color: #ff6b5b;
}

.form-textarea {
  width: 100%;
  min-height: 240rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.form-count {
  display: block;
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.submit-btn {
  margin-top: 48rpx;
  width: 100%;
  height: 88rpx;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border-radius: 44rpx;
  border: none;
  line-height: 1;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  opacity: 0.5;
}
