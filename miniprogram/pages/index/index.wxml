<!-- 首页 - 现代化 redesign 版本 -->
<scroll-view scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="page-scroll" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresherRefresh">
  <view class="container">

    <!-- 头部区域：问候 + 家庭名称 + 通知 -->
    <view class="header-section">
      <view class="header-top">
        <view class="user-info">
          <view class="greeting">{{greeting}}</view>
          <view class="family-name">{{familyName}}</view>
        </view>
        <view class="header-actions">
          <view class="notification-btn" bindtap="onViewAllReminders">
            <view class="bell-icon">
              <image src="../../assets/icons/bell.svg" mode="aspectFit" />
            </view>
            <view class="notification-badge" wx:if="{{urgentCount > 0}}">{{urgentCount}}</view>
          </view>
        </view>
      </view>

      <!-- 统计卡片区 - 紧凑一体化设计 -->
      <view class="stats-card">
        <view class="stat-cell">
          <view class="stat-main">{{itemStats.total}}</view>
          <view class="stat-sub">总物品</view>
        </view>
        <view class="stat-cell">
          <view class="stat-main warning">{{itemStats.expiringSoon}}</view>
          <view class="stat-sub">临期</view>
        </view>
        <view class="stat-cell">
          <view class="stat-main danger">{{itemStats.expired}}</view>
          <view class="stat-sub">已过期</view>
        </view>
      </view>
    </view>

    <!-- 主要功能区 -->
    <view class="main-content">

      <!-- 快捷入口 - 大胆渐变设计 -->
      <view class="quick-actions-section">
        <view class="section-header-minimal">
          <text class="section-title-minimal">快捷操作</text>
        </view>
        <view class="quick-actions-row">
          <!-- 快速存物 - 珊瑚红渐变 -->
          <view class="action-card-row store-card-row" bindtap="onStoreItem">
            <view class="card-gradient-bg store-gradient"></view>
            <view class="card-decoration-circle store-deco-1"></view>
            <view class="card-decoration-circle store-deco-2"></view>
            <view class="card-content-layer-row">
              <view class="icon-container-row">
                <image class="action-icon-row" src="../../assets/icons/camera.svg" mode="aspectFit" />
              </view>
              <view class="text-layer-row">
                <text class="action-title-row">快速存物</text>
              </view>
            </view>
          </view>

          <!-- 对话找物 - 蓝紫渐变 -->
          <view class="action-card-row find-card-row" bindtap="onFindItem">
            <view class="card-gradient-bg find-gradient"></view>
            <view class="card-decoration-circle find-deco-1"></view>
            <view class="card-decoration-circle find-deco-2"></view>
            <view class="card-content-layer-row">
              <view class="icon-container-row">
                <image class="action-icon-row" src="../../assets/icons/messages-square.svg" mode="aspectFit" />
              </view>
              <view class="text-layer-row">
                <text class="action-title-row">对话找物</text>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 智能提醒 -->
      <view class="reminders-section" wx:if="{{displayReminders.length > 0}}">
        <view class="section-header">
          <view class="section-title">
            <view class="title-icon-wrapper">
              <image class="section-icon" src="../../assets/icons/bell.svg" mode="aspectFit" />
            </view>
            <text>智能提醒</text>
            <view class="count-badge">{{reminders.length}}</view>
          </view>
          <view class="section-more" bindtap="onViewAllReminders">
            <text>查看全部</text>
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="reminder-list">
          <view class="reminder-card {{item.level}}" wx:for="{{displayReminders}}" wx:key="id">
            <view class="reminder-card-inner">
              <view class="reminder-status-bar"></view>
              <view class="reminder-body">
                <view class="reminder-icon-wrapper">
                  <text class="reminder-emoji">{{item.icon || '📌'}}</text>
                </view>
                <view class="reminder-content-wrapper">
                  <view class="reminder-title-row">
                    <text class="reminder-title">{{item.display_title || item.title || item.item_name || '提醒'}}</text>
                    <view class="reminder-time-badge {{item.level}}">{{item.time_label || '查看'}}</view>
                  </view>
                  <view class="reminder-detail-row">
                    <text class="reminder-expire-date" wx:if="{{item.expire_at_display}}">{{item.expire_at_display}} 过期</text>
                    <text class="reminder-divider" wx:if="{{item.expire_at_display && item.display_content}}">·</text>
                    <text class="reminder-location" wx:if="{{item.display_content}}">{{item.display_content}}</text>
                  </view>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 最近存放 -->
      <view class="recent-section">
        <view class="section-header">
          <view class="section-title">
            <view class="title-icon-wrapper">
              <image class="section-icon" src="../../assets/icons/history.svg" mode="aspectFit" />
            </view>
            <text>最近存放</text>
          </view>
          <view class="section-more" bindtap="onViewAllItems">
            <text>查看全部</text>
            <text class="arrow">›</text>
          </view>
        </view>

        <view class="empty-state" wx:if="{{recentItems.length === 0 && !loading}}">
          <view class="empty-illustration">
            <view class="empty-box">📦</view>
          </view>
          <text class="empty-text">还没有物品，去存第一个吧~</text>
          <view class="empty-action" bindtap="onStoreItem">
            <text>立即存物</text>
          </view>
        </view>

        <view class="item-list" wx:if="{{recentItems.length > 0}}">
          <view class="item-card" wx:for="{{recentItems}}" wx:key="id" bindtap="onItemClick" data-id="{{item.id}}">
            <view class="item-image-wrapper">
              <image wx:if="{{item.photo_path}}" class="item-image" src="{{item.photo_path}}" mode="aspectFill" />
              <view wx:else class="item-image-placeholder">
                <image class="item-placeholder-icon" src="{{item.category_icon || '../../assets/icons/map-pin.svg'}}" mode="aspectFit" />
              </view>
              <view class="item-category-tag" wx:if="{{item.category_name}}">{{item.category_name}}</view>
            </view>
            <view class="item-info">
              <view class="item-name">{{item.name}}</view>
              <view class="item-location-row">
                <image class="location-icon" src="../../assets/icons/location-dot.svg" mode="aspectFit" />
                <text class="item-location">{{item.location}}</text>
              </view>
              <view class="item-meta">
                <text class="meta-creator">{{item.creator_name || '我'}}</text>
                <view class="meta-divider"></view>
                <text class="meta-time">{{item.created_at_label}}</text>
              </view>
            </view>
            <view class="item-arrow">›</view>
          </view>
        </view>
      </view>

      <!-- 底部留白 -->
      <view class="bottom-spacer"></view>
    </view>
  </view>
</scroll-view>
