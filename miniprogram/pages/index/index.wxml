<!-- 首页 - 参考设计原型 v3，使用 scroll-view 保证真机可正常上下滑动 -->
<scroll-view scroll-y="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="page-scroll" refresher-enabled="{{true}}" refresher-triggered="{{refreshing}}" bindrefresherrefresh="onRefresherRefresh">
<view class="container">
  <!-- 头部 -->
  <view class="home-header">
    <view class="home-greeting">{{greeting}} 👋</view>
    <view class="home-title">{{familyName}}</view>
  </view>

  <!-- 搜索框：输入确认带词跳找物，点击右侧语音图标直接进找物 -->
  <view class="search-container">
    <view class="search-box">
      <image class="search-icon" src="../../assets/icons/search.svg" mode="widthFix" />
      <input
        class="search-input"
        placeholder="搜索物品，或试试语音..."
        placeholder-class="search-placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearch"
      />
      <view class="search-voice-icon" bindtap="onSearchTap">
        <image class="search-voice-icon-img" src="../../assets/icons/mic.svg" mode="aspectFit" />
      </view>
    </view>
  </view>

  <!-- 快捷入口 -->
  <view class="quick-actions">
    <view class="quick-action store" bindtap="onStoreItem">
      <view class="action-icon">
        <image class="action-icon-img" src="../../assets/icons/camera.svg" mode="aspectFit" />
      </view>
      <text class="action-label">快速存物</text>
      <text class="action-desc">拍照 + 语音录入</text>
    </view>
    <view class="quick-action chat" bindtap="onFindItem">
      <view class="action-icon">
        <image class="action-icon-img" src="../../assets/icons/messages-square.svg" mode="aspectFit" />
      </view>
      <text class="action-label">对话找物</text>
      <text class="action-desc">AI 智能搜索</text>
    </view>
  </view>

  <!-- 智能提醒：与最近存放同级别，仅展示离过期时间最近的 3 条 -->
  <view class="section" wx:if="{{displayReminders.length > 0}}">
    <view class="section-header">
      <view class="section-title">
        <text>智能提醒</text>
        <text class="badge">{{reminders.length}}</text>
      </view>
      <text class="section-more" bindtap="onViewAllReminders">查看全部 ›</text>
    </view>

    <view class="reminder-list">
      <view class="reminder-card {{item.level}}" wx:for="{{displayReminders}}" wx:key="id">
        <view class="reminder-header">
          <view class="reminder-icon">{{item.icon || '📌'}}</view>
          <view class="reminder-header-text">
            <text class="reminder-title">{{item.display_title || item.title || item.item_name || '提醒'}}</text>
            <text class="reminder-expire-date" wx:if="{{item.expire_at_display}}">过期时间：{{item.expire_at_display}}</text>
          </view>
          <text class="reminder-time" wx:if="{{item.time_label}}">{{item.time_label}}</text>
        </view>
        <view class="reminder-content" wx:if="{{item.display_content || item.content}}">{{item.display_content || item.content}}</view>
        <!-- <view class="reminder-actions">
          <button class="reminder-btn primary" data-id="{{item.id}}" data-action="done" bindtap="onHandleReminder">✅ 已处理</button>
          <button wx:if="{{item.level === 'urgent'}}" class="reminder-btn secondary" data-id="{{item.id}}" data-action="defer" bindtap="onHandleReminder">⏰ 延期</button>
          <button wx:else class="reminder-btn secondary" data-id="{{item.id}}" data-action="ignore" bindtap="onHandleReminder">❌ 忽略</button>
        </view> -->
      </view>
    </view>
  </view>

  <!-- 最近存放：与智能提醒同级别 -->
  <view class="section">
    <view class="section-header">
      <view class="section-title">
        <text>最近存放</text>
      </view>
      <text class="section-more" bindtap="onViewAllItems">查看全部 ›</text>
    </view>

    <view class="empty-state" wx:if="{{recentItems.length === 0 && !loading}}">
      <text class="empty-text">还没有物品，去存第一个吧~</text>
    </view>

    <view class="item-list">
      <view class="item-card" wx:for="{{recentItems}}" wx:key="id" bindtap="onItemClick" data-id="{{item.id}}">
        <image wx:if="{{item.photo_path}}" class="item-image" src="{{item.photo_path}}" mode="aspectFill" />
        <view wx:else class="item-image item-image-placeholder">
          <image class="item-placeholder-icon" src="../../assets/icons/map-pin.svg" mode="aspectFit" />
        </view>
        <view class="item-info">
          <view class="item-name">{{item.name}}</view>
          <view class="item-location">📍 {{item.location}}</view>
          <view class="item-meta">
            <text>{{item.creator_name || '我'}}</text>
            <text class="dot"></text>
            <text>{{item.created_at}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>
</scroll-view>
