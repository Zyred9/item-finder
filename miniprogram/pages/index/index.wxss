/* 首页样式 - 现代化 redesign 版本 */
/* 设计语言：温暖收纳 · 有序生活 */

/* ========== 变量定义 ========== */
page {
  --primary-color: #ff6b5b;
  --primary-light: #ff8e72;
  --primary-gradient: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);

  --secondary-color: #6c5ce7;
  --secondary-light: #a29bfe;
  --secondary-gradient: linear-gradient(135deg, #6c5ce7 0%, #a29bfe 100%);

  --success-color: #00b894;
  --warning-color: #fdcb6e;
  --danger-color: #ff7675;

  --bg-color: #f8f9fa;
  --card-bg: #ffffff;
  --text-primary: #2d3436;
  --text-secondary: #636e72;
  --text-muted: #b2bec3;

  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --shadow-lg: 0 12rpx 40rpx rgba(0, 0, 0, 0.12);

  --radius-sm: 16rpx;
  --radius-md: 24rpx;
  --radius-lg: 32rpx;
  --radius-xl: 40rpx;
}

.page-scroll {
  height: 100vh;
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-color);
}

.container {
  min-height: 100%;
  background: var(--bg-color);
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* ========== 头部区域 ========== */
.header-section {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 20rpx 40rpx 50rpx;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.header-section::before {
  content: '';
  position: absolute;
  top: -60rpx;
  right: -60rpx;
  width: 240rpx;
  height: 240rpx;
  background: rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.header-section::after {
  content: '';
  position: absolute;
  bottom: 40rpx;
  left: -40rpx;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  z-index: 1;
}

.user-info {
  flex: 1;
}

.greeting {
  color: rgba(255, 255, 255, 0.9);
  font-size: 26rpx;
  font-weight: 400;
  margin-bottom: 8rpx;
}

.family-name {
  color: #ffffff;
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.header-actions {
  display: flex;
  align-items: center;
}

/* 通知铃铛按钮 - 精致设计 */
.notification-btn {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bell-icon {
  width: 76rpx;
  height: 76rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(12rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.bell-icon image {
  width: 38rpx;
  height: 38rpx;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}

/* 通知徽章 - 数字显示 */
.notification-badge {
  position: absolute;
  top: 4rpx;
  right: 4rpx;
  min-width: 36rpx;
  height: 36rpx;
  background: linear-gradient(135deg, #ff4757 0%, #ff3838 100%);
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  border: 3rpx solid #ff6b5b;
  box-shadow: 0 4rpx 12rpx rgba(255, 71, 87, 0.4);
}

/* ========== 统计卡片 - 紧凑一体化设计 ========== */
.stats-card {
  background: #ffffff;
  border-radius: 28rpx;
  padding: 28rpx 36rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 60rpx 0rpx 0;
  position: relative;
  z-index: 10;
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.1);
}

.stat-cell {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat-main {
  font-size: 52rpx;
  font-weight: 800;
  color: #2d3436;
  line-height: 1;
  letter-spacing: -2rpx;
}

.stat-main.warning {
  color: #ff9500;
}

.stat-main.danger {
  color: #ff4757;
}

.stat-sub {
  font-size: 22rpx;
  color: #999;
  font-weight: 500;
}

/* 通知按钮点击反馈 */
.notification-btn:active .bell-icon {
  transform: scale(0.92);
  transition: transform 0.15s ease;
}

.notification-btn:active .notification-badge {
  transform: scale(0.92);
  transition: transform 0.15s ease;
}

/* ========== 主内容区 ========== */
.main-content {
  padding: 0;
}

/* ========== 快捷操作区 - 大胆渐变设计 (并排布局) ========== */
.quick-actions-section {
  padding: 36rpx 40rpx 24rpx;
}

.section-header-minimal {
  margin-bottom: 20rpx;
}

.section-title-minimal {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.5rpx;
}

/* 并排布局容器 */
.quick-actions-row {
  display: flex;
  gap: 16rpx;
}

.quick-actions-row .action-card-row {
  flex: 1;
}

/* ========== 卡片主体 - 渐变背景 ========== */
.action-card-row {
  position: relative;
  border-radius: 20rpx;
  overflow: hidden;
  height: 180rpx;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
}

.action-card-row:active {
  transform: scale(0.95);
}

/* 渐变背景层 */
.card-gradient-bg {
  position: absolute;
  inset: 0;
}

/* 快速存物 - 珊瑚红渐变 */
.store-gradient {
  background: linear-gradient(135deg, #FF6B5B 0%, #FF8E72 100%);
}

/* 对话找物 - 蓝紫渐变 */
.find-gradient {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
}

/* 装饰圆圈 - 增加层次感 */
.card-decoration-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}

.store-deco-1 {
  width: 120rpx;
  height: 120rpx;
  top: -50rpx;
  right: -30rpx;
}

.store-deco-2 {
  width: 80rpx;
  height: 80rpx;
  bottom: -30rpx;
  left: 40rpx;
}

.find-deco-1 {
  width: 100rpx;
  height: 100rpx;
  top: -40rpx;
  right: 20rpx;
}

.find-deco-2 {
  width: 70rpx;
  height: 70rpx;
  bottom: -25rpx;
  left: 60rpx;
}

/* 内容层 */
.card-content-layer-row {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100%;
  gap: 12rpx;
}

/* 图标容器 */
.icon-container-row {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(8rpx);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  border: 1rpx solid rgba(255, 255, 255, 0.25);
}

.action-icon-row {
  width: 36rpx;
  height: 36rpx;
  filter: brightness(0) invert(1);
  opacity: 0.95;
}

/* 文字层 */
.text-layer-row {
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
}

.action-title-row {
  font-size: 30rpx;
  font-weight: 700;
  color: #ffffff;
  letter-spacing: -0.5rpx;
}

/* ========== 区块通用样式 ========== */
.reminders-section,
.recent-section {
  padding: 0 40rpx 40rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-primary);
}

/* 智能提醒标题图标 - 珊瑚红渐变 */
.section-title .title-icon-wrapper {
  width: 44rpx;
  height: 44rpx;
  border-radius: 14rpx;
  background: linear-gradient(135deg, #ff9a9e 0%, #ff6b5b 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 16rpx rgba(255, 107, 91, 0.3);
}

/* 最近存放标题图标 - 蓝绿渐变 */
.recent-section .title-icon-wrapper {
  background: linear-gradient(135deg, #89f7fe 0%, #66a6ff 100%);
  box-shadow: 0 6rpx 16rpx rgba(102, 166, 255, 0.3);
}

.section-icon {
  width: 26rpx;
  height: 26rpx;
  filter: brightness(0) invert(1);
}

.count-badge {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  color: #fff;
  font-size: 20rpx;
  font-weight: 700;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
  margin-left: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 91, 0.25);
}

.section-more {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 26rpx;
  color: var(--text-muted);
  transition: color 0.2s ease;
}

.section-more:active {
  color: var(--primary-color);
}

.arrow {
  font-size: 32rpx;
}

/* ========== 提醒列表 ========== */
.reminder-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  /* 兼容性回退方案 */
}

.reminder-card + .reminder-card {
  margin-top: 20rpx;
}

.reminder-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  overflow: hidden;
  box-shadow: var(--shadow-md);
}

.reminder-card-inner {
  position: relative;
}

.reminder-status-bar {
  height: 6rpx;
  width: 100%;
}

.reminder-card.urgent .reminder-status-bar {
  background: linear-gradient(90deg, #ff7675 0%, #d63031 100%);
}

.reminder-card.warning .reminder-status-bar {
  background: linear-gradient(90deg, #fdcb6e 0%, #ffa502 100%);
}

.reminder-card.normal .reminder-status-bar {
  background: linear-gradient(90deg, #00b894 0%, #00cec9 100%);
}

.reminder-body {
  display: flex;
  align-items: flex-start;
  padding: 28rpx;
  gap: 24rpx;
}

.reminder-icon-wrapper {
  width: 80rpx;
  height: 80rpx;
  border-radius: var(--radius-md);
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.reminder-emoji {
  font-size: 40rpx;
}

.reminder-content-wrapper {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.reminder-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.reminder-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-primary);
  flex: 1;
}

.reminder-time-badge {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  flex-shrink: 0;
}

.reminder-time-badge.urgent {
  background: linear-gradient(135deg, #ff7675 0%, #d63031 100%);
  color: #fff;
}

.reminder-time-badge.warning {
  background: linear-gradient(135deg, #fdcb6e 0%, #ffa502 100%);
  color: #fff;
}

.reminder-time-badge.normal {
  background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
  color: #fff;
}

.reminder-detail-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.reminder-detail-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}

.reminder-expire-date,
.reminder-location {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.reminder-divider {
  font-size: 20rpx;
  color: var(--text-muted);
}

/* ========== 最近存放 ========== */
.item-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  /* 兼容性回退方案 */
}

.item-card + .item-card {
  margin-top: 20rpx;
}

.item-card {
  background: var(--card-bg);
  border-radius: var(--radius-lg);
  padding: 24rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: all 0.2s ease;
}

.item-card:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

.item-image-wrapper {
  position: relative;
  flex-shrink: 0;
}

.item-image,
.item-image-placeholder {
  width: 144rpx;
  height: 144rpx;
  border-radius: var(--radius-md);
  overflow: hidden;
}

.item-image {
  background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}

.item-image-placeholder {
  background: linear-gradient(135deg, #f0f4f8 0%, #d9e2ec 100%);
  display: flex;
  align-items: center;
  justify-content: center;
}

.item-placeholder-icon {
  width: 64rpx;
  height: 64rpx;
  opacity: 0.5;
}

.item-category-tag {
  position: absolute;
  bottom: 12rpx;
  left: 12rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  backdrop-filter: blur(8rpx);
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.item-name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-primary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-location-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-left: 8rpx;
}

.location-icon {
  width: 24rpx;
  height: 24rpx;
  opacity: 0.6;
}

.item-location {
  font-size: 24rpx;
  color: var(--text-secondary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-creator,
.meta-time {
  font-size: 22rpx;
  color: var(--text-muted);
}

.meta-divider {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary-color);
}

.item-arrow {
  font-size: 40rpx;
  color: var(--text-muted);
  flex-shrink: 0;
}

/* ========== 空状态 ========== */
.empty-state {
  padding: 80rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.empty-illustration {
  width: 160rpx;
  height: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-box {
  font-size: 100rpx;
  animation: float 3s ease-in-out infinite;
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-20rpx); }
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-muted);
}

.empty-action {
  background: var(--primary-gradient);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
  padding: 20rpx 48rpx;
  border-radius: var(--radius-xl);
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 91, 0.3);
}

/* ========== 底部留白 ========== */
.bottom-spacer {
  height: 60rpx;
}
