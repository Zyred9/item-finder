/* 我的页面 - 对齐设计原型 v3 */

.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(120rpx + constant(safe-area-inset-bottom));
}

/* 头部 */
.profile-header {
  background: linear-gradient(135deg, #00b894 0%, #55efc4 100%);
  padding: 60rpx 40rpx 100rpx;
  text-align: center;
  position: relative;
  overflow: hidden;
}

.profile-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -30%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.profile-avatar {
  width: 176rpx;
  height: 176rpx;
  border-radius: 50%;
  background: #fff;
  margin: 0 auto 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 8rpx solid rgba(255, 255, 255, 0.3);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  position: relative;
  z-index: 1;
}

.profile-avatar-img {
  width: 96rpx;
  height: 96rpx;
}

.profile-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 12rpx;
  position: relative;
  z-index: 1;
}

.profile-family {
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  z-index: 1;
}

.profile-badge {
  background: rgba(255, 255, 255, 0.25);
  padding: 6rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-right: 12rpx;
}

.profile-role {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.88);
}

/* 菜单区 */
.profile-menu {
  padding: 0 40rpx;
  margin-top: -32rpx;
  position: relative;
  z-index: 2;
}

.menu-group {
  background: #fff;
  border-radius: 36rpx;
  overflow: hidden;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 32rpx 36rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.menu-icon-img {
  width: 40rpx;
  height: 40rpx;
}

.menu-icon.family {
  background: linear-gradient(135deg, #fff5f4, #ffe8e3);
}

.menu-icon.notification {
  background: linear-gradient(135deg, #e8f9f5, #d0f0e5);
}

.menu-icon.privacy {
  background: linear-gradient(135deg, #f0f7ff, #e0efff);
}

.menu-icon.help {
  background: linear-gradient(135deg, #f0fff7, #e0ffeb);
}

.menu-icon.about {
  background: linear-gradient(135deg, #fff9f0, #fff0e0);
}

.menu-icon.stats {
  background: linear-gradient(135deg, #fff0f5, #ffe0ea);
}

.menu-content {
  flex: 1;
  min-width: 0;
}

.menu-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a2e;
}

.menu-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 4rpx;
}

.menu-right {
  display: flex;
  align-items: center;
}

.menu-badge {
  background: linear-gradient(135deg, #ff6b5b, #ff8e72);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  margin-right: 16rpx;
}

.menu-arrow {
  color: #999;
  font-size: 32rpx;
}

.logout-btn {
  width: 100%;
  margin: 0 0 24rpx;
  padding: 32rpx;
  background: #fff;
  color: #ff4d4f;
  border: 2rpx solid #ff4d4f;
  border-radius: 28rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.logout-btn::after {
  border: none;
}

.profile-footer {
  text-align: center;
  color: #999;
  font-size: 24rpx;
  padding: 40rpx 0;
}
