/* 智能提醒列表 - 与首页智能提醒展示一致 */
.container {
  padding: 20rpx 40rpx;
  min-height: 100vh;
  background: #fafafa;
}

.empty {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon-wrap {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, rgba(255, 107, 91, 0.12) 0%, rgba(255, 142, 114, 0.12) 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.empty-icon {
  font-size: 80rpx;
}

.empty-text {
  display: block;
  color: #999;
  margin-top: 24rpx;
  font-size: 28rpx;
}

.reminder-list {
  display: flex;
  flex-direction: column;
  margin-bottom: -24rpx;
}

.reminder-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.reminder-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 10rpx;
}

.reminder-card.urgent::before {
  background: linear-gradient(180deg, #ff6b6b, #ff8e8e);
}

.reminder-card.warning::before {
  background: linear-gradient(180deg, #ffb347, #ffd48e);
}

.reminder-card.normal::before {
  background: linear-gradient(180deg, #4ecdc4, #8ee4dc);
}

.reminder-card.urgent {
  background: linear-gradient(135deg, #fff5f5 0%, #fff 100%);
}

.reminder-header {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.reminder-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  background: rgba(255, 255, 255, 0.8);
  margin-right: 20rpx;
  overflow: hidden;
  flex-shrink: 0;
}

.reminder-icon-img {
  width: 100%;
  height: 100%;
  border-radius: 24rpx;
}

.reminder-header-text {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.reminder-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.reminder-expire-date {
  font-size: 24rpx;
  color: #666;
  margin-top: 6rpx;
}

.reminder-time {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.reminder-card.urgent .reminder-time {
  background: linear-gradient(135deg, #ff6b6b, #ff8e8e);
  color: #fff;
}

.reminder-card.warning .reminder-time {
  background: linear-gradient(135deg, #ffb347, #ffd48e);
  color: #fff;
}

.reminder-card.normal .reminder-time {
  background: linear-gradient(135deg, #4ecdc4, #8ee4dc);
  color: #fff;
}

.reminder-content {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  margin-bottom: 24rpx;
}

.reminder-actions {
  display: flex;
}

.reminder-actions .reminder-btn + .reminder-btn {
  margin-left: 16rpx;
}

.reminder-btn {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 32rpx;
  margin: 0;
  border-radius: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  text-align: center;
  border: none;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
}

.reminder-btn::after {
  border: none;
}

.reminder-btn.primary {
  background: linear-gradient(135deg, #ff6b5b, #ff8e72);
  color: #fff;
}

.reminder-btn.secondary {
  background: #f5f5f5;
  color: #666;
}
