.container { padding: 20rpx; min-height: 100vh; background: #f5f5f5; }
.empty { text-align: center; padding: 100rpx 0; }
.empty-icon { font-size: 80rpx; }
.empty-text { display: block; color: #999; margin-top: 20rpx; }
.reminder-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; border-left: 6rpx solid #00B894; }
.reminder-card.warning { border-left-color: #f5a623; }
.reminder-card.urgent { border-left-color: #FF6B5B; }
.reminder-header { display: flex; justify-content: space-between; align-items: center; }
.reminder-title { font-size: 30rpx; font-weight: bold; }
.reminder-level { font-size: 24rpx; padding: 4rpx 12rpx; background: #f0f0f0; border-radius: 8rpx; color: #666; }
.reminder-card.urgent .reminder-level { background: #ffebeb; color: #FF6B5B; }
.reminder-body { margin-top: 16rpx; }
.reminder-content { font-size: 26rpx; color: #666; }
.reminder-item { margin-top: 10rpx; font-size: 26rpx; color: #999; }
.reminder-actions { display: flex; gap: 20rpx; margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.action-btn { padding: 8rpx 24rpx; background: #FF6B5B; color: #fff; border-radius: 8rpx; font-size: 26rpx; }
.action-btn.ignore { background: #f0f0f0; color: #999; }