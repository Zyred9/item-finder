<!-- 存物页面 - 对齐设计原型 v3 -->
<view class="container">
  <!-- 页面头部 -->
  <view class="store-header">
    <view class="store-title">📦 快速存物</view>
    <view class="store-desc">拍照或语音，轻松记录物品位置</view>
  </view>

  <!-- 拍照区卡片 -->
  <view class="section">
    <view class="photo-card" bindtap="onTakePhoto">
      <image wx:if="{{formData.photo_path}}" class="photo-preview" src="{{formData.photo_path}}" mode="aspectFill" />
      <view wx:else class="photo-placeholder">
        <view class="photo-icon-wrap">
          <text class="photo-icon">📷</text>
        </view>
        <text class="photo-text">点击拍照或从相册选择</text>
        <text class="photo-hint">添加物品照片，便于日后查找</text>
      </view>
    </view>
  </view>

  <!-- 语音录入卡片 -->
  <view class="section">
    <view class="voice-card">
      <view class="voice-card-title">🎤 语音录入</view>
      <view class="voice-card-desc">说出「物品名 + 存放位置」自动填充到下方表单</view>
      <button
        class="voice-btn {{isRecording ? 'recording' : ''}}"
        bindtouchstart="onStartRecord"
        bindtouchend="onStopRecord"
      >
        {{isRecording ? '正在录音...' : '按住 说话'}}
      </button>
      <view class="voice-result-block" wx:if="{{showVoiceResult && voiceResultText}}">
        <view class="voice-result-label">识别结果</view>
        <view class="voice-result-text">{{voiceResultText}}</view>
      </view>
    </view>
  </view>

  <!-- 表单信息卡片 -->
  <view class="section">
    <view class="form-card">
      <view class="form-card-title">📋 物品信息</view>

      <view class="form-item">
        <text class="form-label">物品名称 <text class="required">*</text></text>
        <input
          class="form-input"
          placeholder="如：吹风机、护照、钥匙"
          placeholder-class="form-placeholder"
          value="{{formData.name}}"
          bindinput="onNameInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">存放位置 <text class="required">*</text></text>
        <input
          class="form-input"
          placeholder="如：主卧抽屉、保险柜第二层"
          placeholder-class="form-placeholder"
          value="{{formData.location}}"
          bindinput="onLocationInput"
        />
      </view>

      <view class="form-item">
        <text class="form-label">物品分类</text>
        <picker mode="selector" range="{{categories}}" range-key="name" bindchange="onCategoryChange">
          <view class="form-picker">
            <text class="picker-value {{selectedCategory ? '' : 'placeholder'}}">{{selectedCategory ? selectedCategory.name : '请选择分类（可选）'}}</text>
            <text class="picker-arrow">›</text>
          </view>
        </picker>
        <view class="category-suggestion" wx:if="{{suggestedCategoryName}}">
          AI 建议分类：{{suggestedCategoryName}}，请确认是否需要手动调整
        </view>
      </view>

      <view class="form-item form-item-last">
        <text class="form-label">描述</text>
        <textarea
          class="form-textarea"
          placeholder="补充说明（可选）"
          placeholder-class="form-placeholder"
          value="{{formData.description}}"
          bindinput="onDescInput"
        />
      </view>
    </view>
  </view>

  <!-- 扩展信息：仅当选中的分类有扩展字段时展示 -->
  <view class="section" wx:if="{{extensionFields.length > 0}}">
    <view class="form-card extension-card">
      <view class="form-card-title">📌 扩展信息</view>
      <view class="extension-modes-desc">支持拍照凭证、语音补充、手动填写三种方式</view>

      <!-- 方式一：拍照（凭证照）+ OCR 提取文字 -->
      <view class="extension-mode-block">
        <view class="extension-mode-label">📷 拍照</view>
        <view class="extension-photo-wrap" bindtap="onExtensionPhoto">
          <image wx:if="{{extensionPhotoPath}}" class="extension-photo-preview" src="{{extensionPhotoPath}}" mode="aspectFill" />
          <view wx:else class="extension-photo-placeholder">
            <text class="extension-photo-icon">📷</text>
            <text class="extension-photo-text">凭证/说明书等</text>
          </view>
        </view>
        <view class="extension-ocr-btn-wrap" wx:if="{{extensionPhotoPath}}">
          <view class="extension-ocr-btn" bindtap="onExtensionOcr">📄 提取文字</view>
        </view>
      </view>

      <!-- 方式二：语音补充 -->
      <view class="extension-mode-block">
        <view class="extension-mode-label">🎤 语音补充</view>
        <view class="extension-voice-row">
          <button
            class="extension-voice-btn {{isRecordingExtension ? 'recording' : ''}}"
            bindtouchstart="onExtensionVoiceStart"
            bindtouchend="onExtensionVoiceEnd"
          >
            {{isRecordingExtension ? '松开发送' : '按住 说话'}}
          </button>
        </view>
        <view class="voice-result-block" wx:if="{{showExtensionVoiceResult && extensionVoiceText}}">
          <view class="voice-result-label">识别结果（可编辑）</view>
          <textarea
            class="extension-voice-textarea"
            placeholder="语音识别结果会出现在这里，可继续编辑"
            value="{{extensionVoiceText}}"
            bindinput="onExtensionVoiceInput"
          />
        </view>
      </view>

      <!-- 方式三：人工输入（扩展字段 + 无分类时的补充说明） -->
      <view class="extension-mode-block extension-manual-block">
        <view class="extension-mode-label">✏️ 手动填写</view>
        <view class="form-item" wx:for="{{extensionFields}}" wx:key="name">
          <text class="form-label">{{item.label}} {{item.required ? '*' : ''}}</text>
          <picker wx:if="{{item.type === 'date'}}" mode="date" bindchange="onDateChange" data-field="{{item.name}}">
            <view class="form-picker">
              <text class="picker-value {{extensionValues[item.name] ? '' : 'placeholder'}}">{{extensionValues[item.name] || '选择日期'}}</text>
              <text class="picker-arrow">📅</text>
            </view>
          </picker>
          <picker wx:elif="{{item.type === 'select'}}" mode="selector" range="{{item.options}}" bindchange="onExtensionInput" data-field="{{item.name}}">
            <view class="form-picker">
              <text class="picker-value {{extensionValues[item.name] ? '' : 'placeholder'}}">{{extensionValues[item.name] || '请选择'}}</text>
              <text class="picker-arrow">›</text>
            </view>
          </picker>
          <input
            wx:elif="{{item.type === 'number'}}"
            class="form-input"
            type="number"
            placeholder="{{item.label}}"
            value="{{extensionValues[item.name]}}"
            bindinput="onExtensionInput"
            data-field="{{item.name}}"
          />
          <input
            wx:else
            class="form-input"
            placeholder="{{item.label}}"
            value="{{extensionValues[item.name]}}"
            bindinput="onExtensionInput"
            data-field="{{item.name}}"
          />
        </view>
        <view class="form-item form-item-last" wx:if="{{extensionFields.length === 0}}">
          <text class="form-label">补充说明</text>
          <textarea
            class="form-textarea"
            placeholder="可填写品牌、型号、保修期等（可选）"
            placeholder-class="form-placeholder"
            value="{{extensionVoiceText}}"
            bindinput="onExtensionVoiceInput"
          />
        </view>
      </view>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-section">
    <button class="submit-btn" loading="{{submitting}}" bindtap="onSubmit">保存物品</button>
  </view>
</view>
