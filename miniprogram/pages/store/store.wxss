/* 存物页面 - 对齐设计原型 v3 */

.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
}

/* 页面头部 */
.store-header {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 48rpx 40rpx 56rpx;
  position: relative;
  overflow: hidden;
}

.store-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.store-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-title-icon {
  width: 40rpx;
  height: 40rpx;
}

.store-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  position: relative;
  z-index: 1;
}

/* 区块通用 */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
}

/* ===== 快速录入卡片（合一） ===== */
.input-card {
  background: #fff;
  border-radius: 32rpx;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.06);
  overflow: hidden;
}

/* 分段选择器 */
.input-mode-seg {
  display: flex;
  padding: 16rpx;
  gap: 12rpx;
  background: #fafafa;
  border-bottom: 1rpx solid #f0f0f2;
}

.seg-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  color: #999;
  font-weight: 500;
  transition: all 0.2s;
}

.seg-item.seg-active {
  background: #fff;
  color: #ff6b5b;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.seg-icon {
  width: 36rpx;
  height: 36rpx;
  opacity: 0.5;
}

.seg-item.seg-active .seg-icon {
  opacity: 1;
}

/* 内容面板 */
.input-panel {
  min-height: 280rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.input-panel-voice {
  flex-direction: column;
  padding: 40rpx 32rpx;
  align-items: stretch;
}

/* 拍照模式 */
.photo-preview {
  width: 100%;
  height: 320rpx;
  display: block;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.photo-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}

.photo-icon {
  width: 52rpx;
  height: 52rpx;
}

.photo-text {
  font-size: 28rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.photo-hint {
  font-size: 24rpx;
  color: #bbb;
}

/* 语音模式 */
.voice-tip {
  font-size: 24rpx;
  color: #bbb;
  text-align: center;
  margin-bottom: 28rpx;
  line-height: 1.5;
}

.voice-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
}

.voice-btn::after {
  border: none;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
}

.voice-btn-icon {
  width: 36rpx;
  height: 36rpx;
  flex-shrink: 0;
}

.voice-result-block {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  background: #f0faf8;
  border-radius: 16rpx;
  border-left: 6rpx solid #00b894;
}

.voice-result-label {
  font-size: 22rpx;
  color: #00b894;
  margin-bottom: 8rpx;
  font-weight: 500;
}

.voice-result-text {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.5;
  word-break: break-all;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.06);
}

.card-title-bar {
  width: 6rpx;
  height: 32rpx;
  border-radius: 3rpx;
  background: linear-gradient(180deg, #ff6b5b 0%, #ff8e72 100%);
  flex-shrink: 0;
}

.form-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.form-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f4;
}

.form-item-last,
.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #999;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-label .required {
  color: #ff6b5b;
}

.form-input-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #ccc;
  margin-top: 8rpx;
}

.form-input-count.warn {
  color: #ff9800;
}

.form-input-count.error {
  color: #ff4d4f;
}

.category-suggestion {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #ff8a65;
}

.form-input,
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1a1a2e;
  background: transparent;
  border-radius: 0;
  box-sizing: border-box;
}

.form-input {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
}

.form-textarea {
  padding: 8rpx 0;
  min-height: 120rpx;
  line-height: 1.6;
}

.form-placeholder {
  color: #c0c0c0;
}

.form-textarea {
  min-height: 160rpx;
  line-height: 1.5;
  padding: 24rpx 28rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 72rpx;
  padding: 0;
  background: transparent;
  border-radius: 0;
}

.picker-value {
  font-size: 28rpx;
  color: #1a1a2e;
}

.picker-value.placeholder {
  color: #b0b0b0;
}

.picker-arrow {
  font-size: 28rpx;
  color: #999;
}

/* ===== 扩展信息卡片（重设计） ===== */

/* 卡片头部：标题 + AI辅助标签 */
.ext-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 0;
}

.ext-header .form-card-title {
  margin-bottom: 0;
  border-bottom: none;
  padding-bottom: 0;
}

.ext-header-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #eef0ff 0%, #e8f4ff 100%);
  font-size: 24rpx;
  color: #5b6af0;
  font-weight: 500;
}

.ext-header-tag-active {
  background: linear-gradient(135deg, #5b6af0 0%, #7b8ff8 100%);
  color: #fff;
}

.ext-header-tag-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

/* AI 辅助识别区域 */
.ext-ai-zone {
  margin-top: 24rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #f7f8ff 0%, #f0f4ff 100%);
  border-radius: 20rpx;
  border: 1rpx solid #e8ebff;
}

.ext-ai-zone-label {
  font-size: 22rpx;
  color: #8891f0;
  font-weight: 500;
  margin-bottom: 20rpx;
  letter-spacing: 0.5rpx;
}

/* 两张操作卡并排 */
.ext-ai-cards {
  display: flex;
  gap: 16rpx;
}

.ext-ai-card {
  flex: 1;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx 16rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  box-shadow: 0 2rpx 12rpx rgba(91, 106, 240, 0.08);
  border: 1rpx solid rgba(91, 106, 240, 0.1);
}

.ext-ai-card-recording {
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e6 100%);
  border-color: rgba(255, 107, 91, 0.25);
}

.ext-ai-card-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ext-ai-card-icon-wrap.camera {
  background: linear-gradient(135deg, #eef0ff 0%, #dde1ff 100%);
}

.ext-ai-card-icon-wrap.mic {
  background: linear-gradient(135deg, #e8f4ff 0%, #d4ecff 100%);
}

.ext-ai-card-icon-wrap.mic-active {
  background: linear-gradient(135deg, #ffe0dc 0%, #ffcbc5 100%);
}

.ext-ai-card-icon {
  width: 40rpx;
  height: 40rpx;
}

.ext-ai-card-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #1a1a2e;
}

.ext-ai-card-hint {
  font-size: 22rpx;
  color: #aaa;
}

/* 凭证照预览（拍照后显示） */
.ext-photo-result {
  margin-top: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e8ebff;
}

.ext-photo-result-img {
  width: 100%;
  height: 200rpx;
  display: block;
}

.ext-photo-result-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 20rpx;
  background: #fff;
}

.ext-photo-done-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: #e8f8f0;
  font-size: 24rpx;
  color: #00b894;
  font-weight: 500;
}

.ext-photo-done-icon {
  width: 24rpx;
  height: 24rpx;
}

.ext-photo-recognizing-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 22rpx;
  background: #f0f4ff;
  font-size: 24rpx;
  color: #8891f0;
  font-weight: 500;
}


/* 语音识别结果 */
.ext-voice-result {
  margin-top: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e8ebff;
}

.ext-voice-result-header {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 14rpx;
}

.ext-voice-result-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.ext-voice-result-label {
  font-size: 24rpx;
  color: #5b6af0;
  font-weight: 500;
}

.ext-voice-textarea {
  width: 100%;
  min-height: 96rpx;
  font-size: 26rpx;
  color: #1a1a2e;
  background: #f7f8ff;
  border-radius: 12rpx;
  padding: 16rpx 18rpx;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 字段区分隔线 */
.ext-section-divider {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 28rpx 0 4rpx;
}

.ext-divider-line {
  flex: 1;
  height: 1rpx;
  background: #f0f0f2;
}

.ext-divider-text {
  font-size: 22rpx;
  color: #c0c0c8;
  font-weight: 500;
  flex-shrink: 0;
}

/* 扩展字段列表 */
.ext-fields-block {
  margin-top: 8rpx;
}

.ext-field-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f2f4;
}

.ext-field-item:last-child,
.ext-field-item.form-item-last {
  border-bottom: none;
  padding-bottom: 0;
}


/* Picker 相关 */
.picker-row {
  display: flex;
  align-items: center;
}

.picker-flex {
  flex: 1;
  min-width: 0;
}

.form-picker.picker-filled {
  background: #f7f8ff;
  border-radius: 12rpx;
  padding: 0 16rpx;
}

.field-clear-btn {
  flex-shrink: 0;
  margin-left: 16rpx;
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  font-size: 32rpx;
  color: #bbb;
  border-radius: 50%;
  background: #f2f2f4;
}

/* 提交区：与底部 tab bar 留出间距 */
.submit-section {
  padding: 48rpx 40rpx 60rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 91, 0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.92;
}
