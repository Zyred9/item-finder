/* 存物页面 - 对齐设计原型 v3 */

.container {
  min-height: 100vh;
  background: #fafafa;
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + constant(safe-area-inset-bottom));
}

/* 页面头部 */
.store-header {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  padding: 48rpx 40rpx 56rpx;
  position: relative;
  overflow: hidden;
}

.store-header::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -20%;
  width: 400rpx;
  height: 400rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.store-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  position: relative;
  z-index: 1;
  margin-bottom: 12rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.store-title-icon {
  width: 40rpx;
  height: 40rpx;
}

.store-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.88);
  position: relative;
  z-index: 1;
}

/* 区块通用 */
.section {
  padding: 0 40rpx;
  margin-top: 32rpx;
}

/* 拍照卡片 */
.photo-card {
  background: #fff;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.06);
  min-height: 320rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.photo-preview {
  width: 100%;
  height: 320rpx;
  display: block;
}

.photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.photo-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #fff5f4 0%, #ffe8e3 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.photo-icon {
  width: 72rpx;
  height: 72rpx;
}

.photo-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
}

.photo-hint {
  font-size: 24rpx;
  color: #999;
}

/* 语音录入卡片 */
.voice-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.06);
}

.voice-card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a2e;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.voice-card-icon {
  width: 32rpx;
  height: 32rpx;
}

.voice-card-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.voice-card-hint {
  font-size: 22rpx;
  color: #b0b0b0;
  margin-bottom: 24rpx;
  line-height: 1.4;
}

.voice-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.voice-btn::after {
  border: none;
}

.voice-btn.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
}

.voice-result-block {
  margin-top: 24rpx;
  padding: 24rpx 28rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  border-left: 6rpx solid #00b894;
}

.voice-result-label {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.voice-result-text {
  font-size: 28rpx;
  color: #1a1a2e;
  line-height: 1.5;
  word-break: break-all;
}

/* 表单卡片 */
.form-card {
  background: #fff;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 32rpx rgba(0, 0, 0, 0.06);
}

.form-card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1a1a2e;
  margin-bottom: 28rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item-last,
.form-item:last-child {
  border-bottom: none;
}

.form-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
}

.form-label .required {
  color: #ff6b5b;
}

.category-suggestion {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: #ff8a65;
}

.form-input,
.form-textarea {
  width: 100%;
  font-size: 28rpx;
  color: #1a1a2e;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

/* 单行输入：无上下 padding，line-height 与 height 一致使文字和光标垂直居中 */
.form-input {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 28rpx;
}

.form-placeholder {
  color: #b0b0b0;
}

.form-textarea {
  min-height: 160rpx;
  line-height: 1.5;
  padding: 24rpx 28rpx;
}

.form-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
}

.picker-value {
  font-size: 28rpx;
  color: #1a1a2e;
}

.picker-value.placeholder {
  color: #b0b0b0;
}

.picker-arrow {
  font-size: 28rpx;
  color: #999;
}

/* 扩展信息卡片 */
.extension-card .form-card-title {
  margin-bottom: 12rpx;
}

.extension-modes-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 28rpx;
  line-height: 1.4;
}

.extension-mode-block {
  margin-bottom: 28rpx;
}

.extension-mode-block:last-child {
  margin-bottom: 0;
}

.extension-mode-label {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
}

.extension-voice-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.extension-photo-wrap {
  width: 100%;
  height: 200rpx;
  background: #f8f8f8;
  border-radius: 16rpx;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.extension-photo-preview {
  width: 100%;
  height: 100%;
}

.extension-photo-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.extension-photo-icon {
  width: 40rpx;
  height: 40rpx;
  margin-bottom: 8rpx;
}

.extension-photo-text {
  font-size: 24rpx;
  color: #999;
}

.extension-ocr-btn-wrap {
  margin-top: 16rpx;
}

.extension-ocr-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 28rpx;
  border-radius: 24rpx;
  font-size: 26rpx;
  color: #00b894;
  background: #e8f8f5;
}

.extension-voice-row {
  margin-bottom: 0;
}

.extension-voice-btn {
  width: 100%;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  font-size: 26rpx;
  color: #fff;
  background: linear-gradient(135deg, #00b894 0%, #00cec9 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.extension-voice-btn::after {
  border: none;
}

.extension-voice-btn.recording {
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
}

.extension-voice-textarea {
  width: 100%;
  min-height: 120rpx;
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  color: #1a1a2e;
  background: #f8f8f8;
  border-radius: 16rpx;
  box-sizing: border-box;
}

.extension-manual-block .form-item {
  padding: 20rpx 0;
}

.extension-manual-block .form-item:first-of-type {
  padding-top: 0;
}

/* 提交区：与底部 tab bar 留出间距 */
.submit-section {
  padding: 48rpx 40rpx 60rpx 40rpx;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, #ff6b5b 0%, #ff8e72 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 91, 0.35);
}

.submit-btn::after {
  border: none;
}

.submit-btn:active {
  opacity: 0.92;
}
